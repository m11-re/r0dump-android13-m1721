+uintptr_t r0dump_UntagAddress(uintptr_t address) {
+  // Android arm64 user virtual addresses currently use at most 56 bits; strip a possible
+  // top-byte/MTE tag before looking the address up in /proc/self/maps or comparing spans.
+  // ART hands out tagged pointers for heap-backed DexFiles (e.g. InMemoryDexClassLoader over a
+  // direct ByteBuffer, whose bytes come from Scudo).  The CPU ignores the tag on dereference
+  // (Top-Byte-Ignore), but /proc/self/maps and process_vm_readv operate in the untagged space,
+  // so every maps/bounds decision must untag first or a perfectly readable DEX looks unmapped.
+  return address & UINT64_C(0x00ffffffffffffff);
+}
+
+bool r0dump_IsBoundedSpan(const uint8_t* begin,
+                          size_t size,
+                          const uint8_t* container_begin,
+                          size_t container_size) {
+  if (begin == nullptr || size == 0u || container_begin == nullptr) {
+    return false;
+  }
+  // Compare spans in the untagged VA space so a tagged header pointer and its (possibly
+  // differently tagged) container are measured consistently.
+  const uintptr_t begin_value = r0dump_UntagAddress(reinterpret_cast<uintptr_t>(begin));
+  const uintptr_t container_begin_value =
+      r0dump_UntagAddress(reinterpret_cast<uintptr_t>(container_begin));
+  if (container_size > UINTPTR_MAX - container_begin_value) {
+    return false;
+  }
+  const uintptr_t container_end_value = container_begin_value + container_size;
+  return begin_value >= container_begin_value && begin_value <= container_end_value &&
+         size <= container_end_value - begin_value;
+}
+
+// A DexFile's logical data range can outlive the mapping that originally backed its header.
+// Before the protected-Dex fallback touches DataBegin/DataSize, prove that the whole span is
+// currently readable and contiguous.  This is intentionally a read-only maps query; it avoids
+// turning a stale or deliberately split range into a process crash during diagnostic capture.
+bool r0dump_IsReadableSpan(const uint8_t* begin, size_t size) {
+  if (begin == nullptr || size == 0u) {
+    return false;
+  }
+  // Untag before every /proc/self/maps lookup: heap-backed DexFiles carry an arm64 top-byte tag
+  // that the CPU ignores on dereference but maps does not, so a tagged-but-readable span would
+  // otherwise be misjudged unmapped.  This is the single choke point for all readability checks.
+  const uintptr_t start = r0dump_UntagAddress(reinterpret_cast<uintptr_t>(begin));
+  if (size > UINTPTR_MAX - start) {
+    return false;
+  }
+  const uintptr_t end = start + size;
+  FILE* maps = fopen("/proc/self/maps", "re");
+  if (maps == nullptr) {
+    return false;
+  }
+  uintptr_t cursor = start;
+  char line[768] = {};
+  while (fgets(line, sizeof(line), maps) != nullptr) {
+    uintptr_t map_start = 0u;
+    uintptr_t map_end = 0u;
+    char permissions[5] = {};
+    if (sscanf(line, "%" SCNxPTR "-%" SCNxPTR " %4s", &map_start, &map_end, permissions) !=
+            3 ||
+        map_end <= cursor) {
+      continue;
+    }
+    if (map_start > cursor || permissions[0] != 'r') {
+      fclose(maps);
+      return false;
+    }
+    cursor = std::min(end, map_end);
+    if (cursor == end) {
+      fclose(maps);
+      return true;
+    }
+  }
+  fclose(maps);
+  return false;
+}
+
+void r0dump_AnnotateLogicalCopy(r0dump_RecordMetadata* metadata,
+                                bool complete,
+                                size_t copied_bytes) {
+  if (metadata == nullptr || metadata->runtime_view_json.empty()) {
+    return;
+  }
+  const size_t closing = metadata->runtime_view_json.find_last_of('}');
+  if (closing == std::string::npos) {
+    return;
+  }
+  metadata->runtime_view_json.insert(
+      closing,
+      ",\"logical_data_complete\":" + std::string(complete ? "true" : "false") +
+          ",\"logical_data_copied_bytes\":" + std::to_string(copied_bytes));
+}
+
+// Copy a logical DexFile data range without ever dereferencing an address that is not covered by
+// a readable mapping. Protected loaders may scatter this range across anonymous mappings and leave
+// guard gaps between them.  Gaps remain zero-filled and are reported to the caller via `complete`;
+// host-side reconstruction still validates all table references before accepting the image.
+std::unique_ptr<uint8_t[]> r0dump_CopyLogicalData(const uint8_t* begin,
+                                                  size_t size,
+                                                  bool* complete,
+                                                  size_t* copied_bytes) {
+  if (complete == nullptr || copied_bytes == nullptr || begin == nullptr || size == 0u ||
+      size > UINTPTR_MAX - reinterpret_cast<uintptr_t>(begin)) {
+    return nullptr;
+  }
+  std::unique_ptr<uint8_t[]> copy(new (std::nothrow) uint8_t[size]());
+  if (copy == nullptr) {
+    return nullptr;
+  }
+  // Untag: the overlap math against /proc/self/maps and the process_vm_readv remote iovec must
+  // all reference the untagged address, otherwise a tagged heap-backed DEX copies zero bytes.
+  const uintptr_t start = r0dump_UntagAddress(reinterpret_cast<uintptr_t>(begin));
+  const uintptr_t end = start + size;
+  *complete = true;
+  *copied_bytes = 0u;
+  FILE* maps = fopen("/proc/self/maps", "re");
+  if (maps == nullptr) {
+    return nullptr;
+  }
+  uintptr_t cursor = start;
+  char line[768] = {};
+  while (fgets(line, sizeof(line), maps) != nullptr) {
+    uintptr_t map_start = 0u;
+    uintptr_t map_end = 0u;
+    char permissions[5] = {};
+    if (sscanf(line, "%" SCNxPTR "-%" SCNxPTR " %4s", &map_start, &map_end, permissions) !=
+            3 ||
+        map_end <= start || map_start >= end || map_end <= map_start) {
+      continue;
+    }
+    const uintptr_t segment_start = std::max(start, map_start);
+    const uintptr_t segment_end = std::min(end, map_end);
+    if (segment_start > cursor) {
+      *complete = false;
+    }
+    if (permissions[0] != 'r') {
+      *complete = false;
+      cursor = std::max(cursor, segment_end);
+      continue;
+    }
+    const size_t segment_size = static_cast<size_t>(segment_end - segment_start);
+    const size_t local_offset = static_cast<size_t>(segment_start - start);
+    const iovec local = {copy.get() + local_offset, segment_size};
+    const iovec remote = {reinterpret_cast<void*>(segment_start), segment_size};
+    ssize_t read_bytes;
+    do {
+      read_bytes = process_vm_readv(getpid(), &local, 1u, &remote, 1u, 0u);
+    } while (read_bytes < 0 && errno == EINTR);
+    if (read_bytes != static_cast<ssize_t>(segment_size)) {
+      *complete = false;
+      if (read_bytes > 0) {
+        *copied_bytes += static_cast<size_t>(read_bytes);
+      }
+    } else {
+      *copied_bytes += segment_size;
+    }
+    cursor = std::max(cursor, segment_end);
+  }
+  fclose(maps);
+  if (cursor < end) {
+    *complete = false;
+  }
+  return copy;
+}
+
+bool r0dump_GetCodeItemSpan(const DexFile& dex_file,
+                            const dex::CodeItem* code_item,
+                            size_t max_code_item_bytes,
+                            const uint8_t** begin,
+                            size_t* size,
+                            uint32_t* code_offset) {
+  const uint8_t* item_begin = reinterpret_cast<const uint8_t*>(code_item);
+  if (begin == nullptr || size == nullptr || code_offset == nullptr ||
+      !r0dump_IsBoundedSpan(item_begin,
+                            StandardDexFile::CodeItem::InsnsOffset(),
+                            dex_file.DataBegin(),
+                            dex_file.DataSize())) {
+    return false;
+  }
+  const CodeItemDataAccessor accessor(dex_file, code_item);
+  const uint8_t* item_end = reinterpret_cast<const uint8_t*>(accessor.CodeItemDataEnd());
+  if (item_end <= item_begin) {
+    return false;
+  }
+  const size_t item_size = static_cast<size_t>(item_end - item_begin);
+  if (item_size > max_code_item_bytes ||
+      !r0dump_IsBoundedSpan(item_begin, item_size, dex_file.DataBegin(), dex_file.DataSize())) {
+    return false;
+  }
+  *begin = item_begin;
+  *size = item_size;
+  *code_offset = static_cast<uint32_t>(item_begin - dex_file.DataBegin());
+  return true;
+}
