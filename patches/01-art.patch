+std::string r0dump_SerializeRecord(const r0dump_PendingRecord& record,
+                                   std::string_view run_id,
+                                   uint32_t pid,
+                                   const r0dump_ArtifactReference* artifact) {
+  std::string json;
+  json.reserve(1024u);
+  json.push_back('{');
+  bool first = true;
+  r0dump_AppendJsonNumber(&json, "schema", std::optional<uint32_t>(1u), &first);
+  r0dump_AppendJsonField(&json, "run_id", run_id, &first);
+  r0dump_AppendJsonNumber(&json, "seq", std::optional<uint64_t>(record.sequence), &first);
+  r0dump_AppendJsonNumber(&json, "pid", std::optional<uint32_t>(pid), &first);
+  r0dump_AppendJsonNumber(&json, "tid", std::optional<uint32_t>(record.tid), &first);
+  r0dump_AppendJsonNumber(
+      &json, "monotonic_ns", std::optional<uint64_t>(record.monotonic_ns), &first);
+  r0dump_AppendJsonNumber(
+      &json, "capture_point_bit", std::optional<uint32_t>(r0dump_PointIndex(record.point)), &first);
+  r0dump_AppendJsonField(&json, "capture_point_name", r0dump_PointName(record.point), &first);
+  r0dump_AppendJsonField(&json, "site", record.site, &first);
+  r0dump_AppendJsonField(
+      &json, "capture_kind", r0dump_CaptureKindName(record.capture_kind), &first);
+  r0dump_AppendJsonField(&json, "dex_format", r0dump_DexFormatName(record.dex_format), &first);
+  r0dump_AppendJsonField(&json, "status", r0dump_RecordStatusName(record.status), &first);
+  r0dump_AppendJsonNumber(&json, "dex_object_id", record.metadata.dex_object_id, &first);
+  r0dump_AppendJsonField(&json, "location_basename", record.metadata.location_basename, &first);
+  r0dump_AppendJsonField(&json,
+                         "location_hash",
+                         record.metadata.location_hash.has_value()
+                             ? r0dump_HexHash(*record.metadata.location_hash)
+                             : std::string(),
+                         &first);
+  r0dump_AppendJsonNumber(&json, "checksum", record.metadata.checksum, &first);
+  r0dump_AppendJsonNumber(&json, "begin", record.metadata.begin, &first);
+  r0dump_AppendJsonNumber(&json, "declared_size", record.metadata.declared_size, &first);
+  r0dump_AppendJsonNumber(&json, "data_begin", record.metadata.data_begin, &first);
+  if (!record.metadata.runtime_view_json.empty()) {
+    if (!first) {
+      json.push_back(',');
+    }
+    first = false;
+    json += "\"runtime_view\":";
+    json += record.metadata.runtime_view_json;
+  }
+  r0dump_AppendJsonNumber(&json, "data_size", record.metadata.data_size, &first);
+  r0dump_AppendJsonNumber(&json, "container_size", record.metadata.container_size, &first);
+  r0dump_AppendJsonField(&json, "source_kind", record.metadata.source_kind, &first);
+  r0dump_AppendJsonNumber(&json, "source_ordinal", record.metadata.source_ordinal, &first);
+  r0dump_AppendJsonNumber(&json, "source_count", record.metadata.source_count, &first);
+  r0dump_AppendJsonBoolean(&json, "source_in_memory", record.metadata.source_in_memory, &first);
+  r0dump_AppendJsonNumber(&json, "class_def_index", record.metadata.class_def_index, &first);
+  r0dump_AppendJsonNumber(&json, "method_index", record.metadata.method_index, &first);
+  r0dump_AppendJsonNumber(&json, "code_item_offset", record.metadata.code_item_offset, &first);
+  r0dump_AppendJsonNumber(&json, "code_item_size", record.metadata.code_item_size, &first);
+  r0dump_AppendJsonField(&json, "class_name", record.metadata.class_name, &first);
+  r0dump_AppendJsonField(&json, "method_name", record.metadata.method_name, &first);
+  r0dump_AppendJsonField(&json, "method_descriptor", record.metadata.method_descriptor, &first);
+  r0dump_AppendJsonNumber(&json,
+                          "artifact_id",
+                          artifact == nullptr ? std::optional<uint64_t>()
+                                              : std::optional<uint64_t>(artifact->artifact_id),
+                          &first);
+  r0dump_AppendJsonField(
+      &json,
+      "artifact_relative_path",
+      artifact == nullptr ? std::string_view() : std::string_view(artifact->relative_path),
+      &first);
+  r0dump_AppendJsonField(&json,
+                         "artifact_fast_hash",
+                         artifact == nullptr ? std::string() : r0dump_HexHash(artifact->fast_hash),
+                         &first);
+  r0dump_AppendJsonNumber(&json, "duplicate_of", record.duplicate_of, &first);
+  r0dump_AppendJsonField(&json, "drop_reason", record.drop_reason, &first);
+  r0dump_AppendJsonNumber(&json, "active_attempt_id", record.metadata.active_attempt_id, &first);
+  r0dump_AppendJsonField(&json, "capture_role", record.metadata.capture_role, &first);
+  r0dump_AppendJsonField(&json, "load_status", record.metadata.load_status, &first);
+  r0dump_AppendJsonField(&json, "resolve_status", record.metadata.resolve_status, &first);
+  r0dump_AppendJsonField(&json, "class_init_status", record.metadata.class_init_status, &first);
+  r0dump_AppendJsonField(&json, "materialize_status", record.metadata.materialize_status, &first);
+  r0dump_AppendJsonField(&json, "dispatch_status", record.metadata.dispatch_status, &first);
+  r0dump_AppendJsonField(&json, "exception_class", record.metadata.exception_class, &first);
+  r0dump_AppendJsonField(&json, "entry_kind", record.metadata.entry_kind, &first);
+  r0dump_AppendJsonNumber(&json, "access_flags", record.metadata.access_flags, &first);
+  r0dump_AppendJsonBoolean(
+      &json, "nterp_entry_fast_path", record.metadata.nterp_entry_fast_path, &first);
+  r0dump_AppendJsonBoolean(
+      &json, "nterp_invoke_fast_path", record.metadata.nterp_invoke_fast_path, &first);
+  r0dump_AppendJsonBoolean(&json, "code_item_present", record.metadata.code_item_present, &first);
+  r0dump_AppendJsonField(
+      &json, "observation_phase", record.metadata.observation_phase, &first);
+  json.append("}\n");
+  return json;
+}
