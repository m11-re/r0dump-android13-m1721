+bool r0dump_ToUint32(jlong value, uint32_t* result) {
+  if (value < 0 || static_cast<uint64_t>(value) > std::numeric_limits<uint32_t>::max()) {
+    return false;
+  }
+  *result = static_cast<uint32_t>(value);
+  return true;
+}
