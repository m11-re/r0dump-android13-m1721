+r0dump_CaptureResult r0dump_CaptureDex(r0dump_BufferPool& pool,
+                                       r0dump_Staging& staging,
+                                       const r0dump_BorrowedDex& borrowed,
+                                       r0dump_CaptureKind kind,
+                                       const r0dump_HookContext& context,
+                                       std::string_view capture_role) {
+  r0dump_RecursionGuard guard;
+  if (!guard.r0dump_Entered()) {
+    return {.status = r0dump_CaptureStatus::kReentrant};
+  }
+
+  // r0dump: packers that decrypt into an anonymous mapping and hand ART a headerless or relocated
+  // view leave GetContainer() null.  Refusing such a DexFile right here discarded the only copy of
+  // an already-decrypted image, so a containerless view whose header no longer validates now
+  // falls through to the logical data range instead (see the kDexView case below).
+  const bool has_container = borrowed.dex.GetContainer() != nullptr;
+  const uint8_t* begin = nullptr;
+  size_t size = 0u;
+  r0dump_DexFormat format = r0dump_DexFormat::kNotApplicable;
+  std::unique_ptr<uint8_t[]> logical_copy;
+  bool logical_copy_complete = true;
+  size_t logical_copy_bytes = 0u;
+  switch (kind) {
+    case r0dump_CaptureKind::kDexView:
+      begin = borrowed.dex.Begin();
+      size = borrowed.dex.Size();
+      format = r0dump_ValidateDexImage(begin, size).value_or(r0dump_DexFormat::kNotApplicable);
+      if (format != r0dump_DexFormat::kNotApplicable || has_container) {
+        break;
+      }
+      // Containerless and the public header is not a usable standard dex: the packer repointed or
+      // invalidated the view, but DataBegin/DataSize is still the range ART itself reads.  Treat it
+      // exactly like a logical-data capture, which is what the class-walk path already does.
+      kind = r0dump_CaptureKind::kDexData;
+      [[fallthrough]];
+    case r0dump_CaptureKind::kDexData:
+      begin = borrowed.dex.DataBegin();
+      size = borrowed.dex.DataSize();
+      if (size == 0u || size > kR0dumpMaxDexBytesHardLimit) {
+        return r0dump_RecordDexDrop(staging, context, kind, format, "invalid_range", borrowed.dex);
+      }
+      logical_copy = r0dump_CopyLogicalData(
+          begin, size, &logical_copy_complete, &logical_copy_bytes);
+      if (logical_copy == nullptr || logical_copy_bytes == 0u) {
+        return r0dump_RecordDexDrop(staging, context, kind, format, "invalid_range", borrowed.dex);
+      }
+      begin = logical_copy.get();
+      // The view's header was unusable, so classify the copied logical range instead; this is the
+      // image host-side rehydration will consume.
+      if (r0dump_IsReadableSpan(begin, sizeof(DexFile::Header))) {
+        format = r0dump_ValidateDexImage(begin, size).value_or(r0dump_DexFormat::kNotApplicable);
+      }
+      break;
+    case r0dump_CaptureKind::kBuffer:
+    case r0dump_CaptureKind::kCodeItem:
+    case r0dump_CaptureKind::kMetadata:
+      return r0dump_RecordDexDrop(
+          staging, context, kind, format, "capture_kind_mismatch", borrowed.dex);
+  }
+  // r0dump: A13's DexFileContainer exposes no raw span, so a kDexView is bounded by the DexFile's
+  // own image ([Begin(), Begin()+Size())), which is exactly the region the container owns.
+  if (size > kR0dumpMaxDexBytesHardLimit ||
+      (kind == r0dump_CaptureKind::kDexView &&
+       (!r0dump_IsBoundedSpan(begin, size, borrowed.dex.Begin(), borrowed.dex.Size()) ||
+        !r0dump_IsReadableSpan(begin, size))) ||
+      (kind == r0dump_CaptureKind::kDexView && format == r0dump_DexFormat::kNotApplicable)) {
+    return r0dump_RecordDexDrop(staging, context, kind, format, "invalid_range", borrowed.dex);
+  }
+  r0dump_RecordMetadata metadata = r0dump_DexMetadata(borrowed.dex);
+  metadata.class_def_index = borrowed.class_def_index;
+  if (!capture_role.empty()) {
+    metadata.capture_role = std::string(capture_role);
+  }
+  if (logical_copy != nullptr) {
+    r0dump_AnnotateLogicalCopy(&metadata, logical_copy_complete, logical_copy_bytes);
+  }
+  if (logical_copy != nullptr) {
+    begin = logical_copy.get();
+  }
+  return r0dump_CopyAndSubmitDex(
+      pool, staging, begin, size, kind, format, context, std::move(metadata));
+}
+
+r0dump_CaptureResult r0dump_CaptureBuffer(r0dump_BufferPool& pool,
+                                          r0dump_Staging& staging,
+                                          const r0dump_BorrowedBuffer& borrowed,
+                                          const r0dump_HookContext& context,
+                                          r0dump_RecordMetadata metadata) {
+  r0dump_RecursionGuard guard;
+  if (!guard.r0dump_Entered()) {
+    return {.status = r0dump_CaptureStatus::kReentrant};
+  }
+  const std::optional<r0dump_DexFormat> format =
+      r0dump_ValidateDexImage(borrowed.begin, borrowed.size);
+  metadata.declared_size = borrowed.size;
+  metadata.container_size = borrowed.container_size;
+  if (borrowed.size > kR0dumpMaxDexBytesHardLimit || !format.has_value() ||
+      !r0dump_IsBoundedSpan(
+          borrowed.begin, borrowed.size, borrowed.container_begin, borrowed.container_size)) {
+    return {
+        .status = r0dump_CaptureStatus::kInvalidRange,
+        .submit = staging.r0dump_RecordDrop(context,
+                                            r0dump_CaptureKind::kBuffer,
+                                            format.value_or(r0dump_DexFormat::kNotApplicable),
+                                            "invalid_range",
+                                            std::move(metadata)),
+    };
+  }
+  return r0dump_CopyAndSubmitDex(pool,
+                                 staging,
+                                 borrowed.begin,
+                                 borrowed.size,
+                                 r0dump_CaptureKind::kBuffer,
+                                 *format,
+                                 context,
+                                 std::move(metadata));
+}
+
+r0dump_CaptureResult r0dump_CaptureCodeItem(r0dump_BufferPool& pool,
+                                            r0dump_Staging& staging,
+                                            const DexFile& dex_file,
+                                            const dex::CodeItem* code_item,
+                                            r0dump_CodeItemKey key,
+                                            r0dump_CodeItemMetadata metadata,
+                                            const r0dump_HookContext& context) {
+  r0dump_RecursionGuard guard;
+  if (!guard.r0dump_Entered()) {
+    return {.status = r0dump_CaptureStatus::kReentrant};
+  }
+  const uint8_t* begin = nullptr;
+  size_t size = 0u;
+  uint32_t actual_offset = 0u;
+  if (!r0dump_GetCodeItemSpan(
+          dex_file, code_item, pool.r0dump_MaxCodeItemBytes(), &begin, &size, &actual_offset)) {
+    return r0dump_RecordCaptureDrop(staging,
+                                    context,
+                                    r0dump_CaptureKind::kCodeItem,
+                                    r0dump_DexFormat::kNotApplicable,
+                                    "invalid_range");
+  }
+  if (key.code_offset != actual_offset) {
+    return r0dump_RecordCaptureDrop(staging,
+                                    context,
+                                    r0dump_CaptureKind::kCodeItem,
+                                    r0dump_DexFormat::kNotApplicable,
+                                    "code_offset_mismatch");
+  }
+  std::unique_ptr<r0dump_OwnedCapture> capture = pool.r0dump_TryAcquire(begin, size);
+  if (capture == nullptr) {
+    return r0dump_RecordCaptureDrop(staging,
+                                    context,
+                                    r0dump_CaptureKind::kCodeItem,
+                                    r0dump_DexFormat::kNotApplicable,
+                                    "pool_unavailable",
+                                    r0dump_CaptureStatus::kPoolUnavailable);
+  }
+  return r0dump_SubmitCapturedCodeItem(
+      staging, std::move(key), std::move(capture), std::move(metadata), context);
+}
