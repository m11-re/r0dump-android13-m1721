+void r0dump_LogRecordEvent(r0dump_LogLevel level,
+                           std::string_view event,
+                           std::string_view status,
+                           const r0dump_PendingRecord& record,
+                           const r0dump_ArtifactReference* artifact,
+                           std::string_view run_id,
+                           uint32_t pid) {
+  const std::unique_ptr<r0dump_RecordLogValues> values = std::make_unique<r0dump_RecordLogValues>();
+  values->sequence = std::to_string(record.sequence);
+  values->thread_id = std::to_string(record.tid);
+  values->process_id = std::to_string(pid);
+  values->monotonic_ns = std::to_string(record.monotonic_ns);
+  values->dex_object_id = r0dump_LogOptionalNumber(record.metadata.dex_object_id);
+  values->location_hash = record.metadata.location_hash.has_value()
+                              ? r0dump_HexHash(*record.metadata.location_hash)
+                              : "-";
+  values->checksum = r0dump_LogOptionalNumber(record.metadata.checksum);
+  values->declared_size = r0dump_LogOptionalNumber(record.metadata.declared_size);
+  values->data_size = r0dump_LogOptionalNumber(record.metadata.data_size);
+  values->container_size = r0dump_LogOptionalNumber(record.metadata.container_size);
+  values->source_ordinal = r0dump_LogOptionalNumber(record.metadata.source_ordinal);
+  values->source_count = r0dump_LogOptionalNumber(record.metadata.source_count);
+  values->source_in_memory = r0dump_LogOptionalBool(record.metadata.source_in_memory);
+  values->class_def_index = r0dump_LogOptionalNumber(record.metadata.class_def_index);
+  values->method_index = r0dump_LogOptionalNumber(record.metadata.method_index);
+  values->code_item_offset = r0dump_LogOptionalNumber(record.metadata.code_item_offset);
+  values->code_item_size = r0dump_LogOptionalNumber(record.metadata.code_item_size);
+  values->artifact_id = artifact == nullptr ? "-" : std::to_string(artifact->artifact_id);
+  const bool has_method =
+      !record.metadata.class_name.empty() &&
+      (!record.metadata.method_name.empty() || !record.metadata.method_descriptor.empty() ||
+       record.capture_kind == r0dump_CaptureKind::kCodeItem);
+  const bool has_class = !record.metadata.class_name.empty();
+  values->object = has_method  ? "method:" + record.metadata.class_name + "#" +
+                                     record.metadata.method_name + record.metadata.method_descriptor
+                   : has_class ? "class:" + record.metadata.class_name
+                   : !record.metadata.location_basename.empty()
+                       ? "dex:" + record.metadata.location_basename + "@" + values->location_hash
+                       : "record:" + values->sequence;
+  r0dump_Log(level,
+             event,
+             {{"status", r0dump_LogValue(status)},
+              {"site", r0dump_LogValue(record.site)},
+              {"run_id", r0dump_LogValue(run_id)},
+              {"pid", values->process_id},
+              {"tid", values->thread_id},
+              {"monotonic_ns", values->monotonic_ns},
+              {"seq", values->sequence},
+              {"point", r0dump_LogValue(r0dump_PointName(record.point))},
+              {"capture_kind", r0dump_LogValue(r0dump_CaptureKindName(record.capture_kind))},
+              {"dex_format", r0dump_LogValue(r0dump_DexFormatName(record.dex_format))},
+              {"object_kind",
+               has_method  ? "method"
+               : has_class ? "class"
+                           : "dex"},
+              {"object", values->object},
+              {"dex", r0dump_LogValue(record.metadata.location_basename)},
+              {"location_hash", values->location_hash},
+              {"dex_object_id", values->dex_object_id},
+              {"checksum", values->checksum},
+              {"declared_size", values->declared_size},
+              {"data_size", values->data_size},
+              {"container_size", values->container_size},
+              {"source", r0dump_LogValue(record.metadata.source_kind)},
+              {"source_ordinal", values->source_ordinal},
+              {"source_count", values->source_count},
+              {"source_in_memory", values->source_in_memory},
+              {"class", r0dump_LogValue(record.metadata.class_name)},
+              {"class_def_index", values->class_def_index},
+              {"method", r0dump_LogValue(record.metadata.method_name)},
+              {"descriptor", r0dump_LogValue(record.metadata.method_descriptor)},
+              {"method_index", values->method_index},
+              {"code_item_offset", values->code_item_offset},
+              {"code_item_size", values->code_item_size},
+              {"capture_role", r0dump_LogValue(record.metadata.capture_role)},
+              {"load_status", r0dump_LogValue(record.metadata.load_status)},
+              {"resolve_status", r0dump_LogValue(record.metadata.resolve_status)},
+              {"class_init_status", r0dump_LogValue(record.metadata.class_init_status)},
+              {"materialize_status", r0dump_LogValue(record.metadata.materialize_status)},
+              {"dispatch_status", r0dump_LogValue(record.metadata.dispatch_status)},
+              {"exception_class", r0dump_LogValue(record.metadata.exception_class)},
+              {"artifact_id", values->artifact_id},
+              {"duplicate_of",
+               record.duplicate_of.has_value() ? std::to_string(*record.duplicate_of) : "-"},
+              {"drop_reason", r0dump_LogValue(record.drop_reason)}});
+}
+
+void r0dump_LogDurableRecord(const r0dump_PendingRecord& record,
+                             const r0dump_ArtifactReference* artifact,
+                             std::string_view run_id,
+                             uint32_t pid) {
+  const std::string_view status = r0dump_RecordStatusName(record.status);
+  r0dump_LogRecordEvent(
+      r0dump_LogLevel::kDebug, "hook_seen", status, record, artifact, run_id, pid);
+  switch (record.status) {
+    case r0dump_RecordStatus::kAccepted:
+      r0dump_LogRecordEvent(
+          r0dump_LogLevel::kDebug, "capture_staged", status, record, artifact, run_id, pid);
+      break;
+    case r0dump_RecordStatus::kDuplicate:
+      r0dump_LogRecordEvent(
+          r0dump_LogLevel::kDebug, "capture_duplicate", status, record, artifact, run_id, pid);
+      break;
+    case r0dump_RecordStatus::kDropped:
+      r0dump_LogRecordEvent(r0dump_LogLevel::kWarn,
+                            "hook_dropped",
+                            record.drop_reason,
+                            record,
+                            artifact,
+                            run_id,
+                            pid);
+      if (record.drop_reason == "active_entry_limit" || record.drop_reason == "artifact_limit" ||
+          record.drop_reason == "total_bytes_limit" || record.drop_reason == "dex_bytes_limit" ||
+          record.drop_reason == "pool_unavailable") {
+        r0dump_LogRecordEvent(r0dump_LogLevel::kWarn,
+                              "budget_exhausted",
+                              record.drop_reason,
+                              record,
+                              artifact,
+                              run_id,
+                              pid);
+      }
+      break;
+  }
+}
