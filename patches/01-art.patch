+
+r0dump_FileResult r0dump_Failure(std::string_view operation, int error) {
+  return {.ok = false, .error = error, .operation = std::string(operation)};
+}
+
+bool r0dump_IsDirectory(int fd) {
+  struct stat status = {};
+  return fstat(fd, &status) == 0 && S_ISDIR(status.st_mode);
+}
+
+gid_t r0dump_ExpectedSharedGid() {
+#if defined(__ANDROID__)
+  return 1078;  // AID_EXT_DATA_RW
+#else
+  return getegid();
+#endif
+}
+
+bool r0dump_IsPreparedDirectory(int fd, uid_t expected_uid, gid_t expected_gid) {
+  struct stat status = {};
+  return fstat(fd, &status) == 0 && S_ISDIR(status.st_mode) && status.st_uid == expected_uid &&
+         status.st_gid == expected_gid && (status.st_mode & 02777) == kR0dumpDirectoryMode;
+}
+
+// r0dump: `expected_uid` is supplied by the caller because the capture engine runs inside the
+// target application process, where the "owner" of the run directory is that application's uid.
+// gid sdcardfs reports for directories below Android/data (AID_SDCARD_RW).
+constexpr gid_t kR0dumpSdcardfsGid = 1015;
+
+bool r0dump_IsOwnedPrivateDirectory(int fd, uid_t owner_uid) {
+  struct stat status = {};
+  if (fstat(fd, &status) != 0 || !S_ISDIR(status.st_mode) || status.st_uid != owner_uid) {
+    return false;
+  }
+  // The run directory holds decrypted application code, so nothing outside the owning application
+  // may be able to read or write it.
+  //
+  // This device keeps Android/data on a separate sdcardfs mount.  sdcardfs synthesises the mode from
+  // its mount options (mask=6) and pins it to 0771, ignoring chmod, so other-execute cannot be
+  // cleared.  Measured on device: a directory created below the app's files/ directory always
+  // reports uid=<app> gid=1015 mode=0771.  Search alone grants no read or write, so o+x is accepted
+  // here; o+r, o+w, set-gid and sticky are still rejected.
+  constexpr mode_t kAllowedOtherBits = S_IXOTH;
+  if ((status.st_mode & (S_IRWXO & ~kAllowedOtherBits)) != 0) {
+    return false;
+  }
+  if ((status.st_mode & (S_ISGID | S_ISVTX)) != 0) {
+    return false;
+  }
+  return status.st_gid == kR0dumpSdcardfsGid || status.st_gid == r0dump_ExpectedSharedGid();
+}
+
+bool r0dump_SetSharedStorageMode(int fd, mode_t mode) {
+  if (fchmod(fd, mode) == 0) {
+    return true;
+  }
+  return errno == EACCES || errno == EPERM;
+}
+
+unique_fd r0dump_OpenPrivateDirectory(int parent_fd, std::string_view name) {
+  const std::string component(name);
+  if (mkdirat(parent_fd, component.c_str(), kR0dumpDirectoryMode) != 0 && errno != EEXIST) {
+    return {};
+  }
+
+  unique_fd directory(
+      openat(parent_fd, component.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+  if (directory.get() < 0) {
+    return {};
+  }
+  if (!r0dump_SetSharedStorageMode(directory.get(), kR0dumpDirectoryMode) ||
+      !r0dump_IsDirectory(directory.get())) {
+    errno = EACCES;
+    return {};
+  }
+  return directory;
+}
+
+unique_fd r0dump_OpenPreparedDirectory(int parent_fd, std::string_view name) {
+  struct stat parent_status = {};
+  if (fstat(parent_fd, &parent_status) != 0 || !S_ISDIR(parent_status.st_mode)) {
+    errno = EINVAL;
+    return {};
+  }
+  const std::string component(name);
+  unique_fd directory(
+      openat(parent_fd, component.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+  if (directory.get() < 0) {
+    return {};
+  }
+  // The helper creates the fixed subdirectories (metadata/artifacts/records/methods) and, on this
+  // device, sdcardfs reports them as uid=<app> gid=1015 mode=0771 regardless of the chown/chmod the
+  // helper issues.  Reuse the same acceptance rule as r0dump_IsPreparedRunDirectory rather than
+  // demanding the FUSE-style (02770, AID_EXT_DATA_RW) triple, which can never hold here.
+  if (!r0dump_IsPreparedDirectory(directory.get(), parent_status.st_uid, parent_status.st_gid) &&
+      !r0dump_IsOwnedPrivateDirectory(directory.get(), parent_status.st_uid)) {
+    errno = EACCES;
+    return {};
+  }
+  return directory;
+}
+
+unique_fd r0dump_OpenUniqueTemporary(int run_fd, std::string* temporary_name) {
+  constexpr size_t kR0dumpMaxAttempts = 32u;
+  for (size_t attempt = 0u; attempt != kR0dumpMaxAttempts; ++attempt) {
+    const uint64_t nonce = g_r0dump_temporary_nonce.fetch_add(1u, std::memory_order_relaxed);
+    char name[64];
+    const int length = snprintf(name, sizeof(name), ".r0dump-%016" PRIx64 ".tmp", nonce);
+    if (length <= 0 || static_cast<size_t>(length) >= sizeof(name)) {
+      errno = EOVERFLOW;
+      return {};
+    }
+    unique_fd temporary(openat(
+        run_fd, name, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, kR0dumpFileMode));
+    if (temporary.get() >= 0) {
+      if (!r0dump_SetSharedStorageMode(temporary.get(), kR0dumpFileMode)) {
+        const int error = errno;
+        temporary.reset();
+        unlinkat(run_fd, name, 0);
+        errno = error;
+        return {};
+      }
+      struct stat parent_status = {};
+      struct stat file_status = {};
+      if (fstat(run_fd, &parent_status) != 0 || fstat(temporary.get(), &file_status) != 0 ||
+          !S_ISREG(file_status.st_mode) || file_status.st_gid != parent_status.st_gid ||
+          (file_status.st_mode & 0777) != kR0dumpFileMode) {
+        const int error = errno == 0 ? EACCES : errno;
+        temporary.reset();
+        unlinkat(run_fd, name, 0);
+        errno = error;
+        return {};
+      }
+      *temporary_name = name;
+      return temporary;
+    }
+    if (errno != EEXIST) {
+      return {};
+    }
+  }
+  errno = EEXIST;
+  return {};
+}
+
+r0dump_FileResult r0dump_WriteSegments(int fd,
+                                       const r0dump_FileSegment* segments,
+                                       size_t segment_count,
+                                       const r0dump_FileIo& io) {
+  for (size_t segment_index = 0u; segment_index != segment_count; ++segment_index) {
+    const r0dump_FileSegment& segment = segments[segment_index];
+    size_t written = 0u;
+    while (written != segment.size) {
+      const ssize_t result = io.write_fn(fd, segment.data + written, segment.size - written);
+      if (result < 0 && errno == EINTR) {
+        continue;
+      }
+      if (result <= 0 || static_cast<size_t>(result) > segment.size - written) {
+        return r0dump_Failure("write", result < 0 ? errno : EIO);
+      }
+      written += static_cast<size_t>(result);
+    }
+  }
+  return r0dump_Success();
+}
+
+int r0dump_FsyncRetry(int fd, const r0dump_FileIo& io) {
+  int result;
+  do {
+    result = io.fsync_fn(fd);
+  } while (result != 0 && errno == EINTR);
+  return result;
+}
