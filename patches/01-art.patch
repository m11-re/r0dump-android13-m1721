+bool r0dump_IsPreparedRunDirectory(int fd) {
+  if (fd < 0) {
+    return false;
+  }
+  // Two layouts are accepted, in this order:
+  //  1. the shared capture directory.  Here the manager creates the run directory inside a
+  //     shared, group-writable tree (mode 02770, AID_EXT_DATA_RW) so a privileged reader can
+  //     collect artifacts afterwards.
+  //  2. the target application's own private directory.  This is what an ordinary app can
+  //     produce on its own: it owns the directory (uid match) and nothing else can reach it.
+  // Both must be non-world-accessible; accepting both keeps the engine usable from a plain app
+  // process while refusing any directory an unrelated user could tamper with.
+  return r0dump_IsPreparedDirectory(fd, geteuid(), r0dump_ExpectedSharedGid()) ||
+         r0dump_IsOwnedPrivateDirectory(fd, geteuid());
+}
+
+r0dump_FileResult r0dump_OpenPreparedRunDirectory(int prepared_fd, int* out_run_fd) {
+  if (prepared_fd < 0 || out_run_fd == nullptr) {
+    return r0dump_Failure("validate_prepared_run", EINVAL);
+  }
+  *out_run_fd = -1;
+
+  struct stat prepared_status = {};
+  if (fstat(prepared_fd, &prepared_status) != 0 || !r0dump_IsPreparedRunDirectory(prepared_fd)) {
+    return r0dump_Failure("validate_prepared_run", errno == 0 ? EACCES : errno);
+  }
+
+  unique_fd directory(openat(prepared_fd, ".", O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+  if (directory.get() < 0) {
+    return r0dump_Failure("open_prepared_run", errno);
+  }
+
+  struct stat directory_status = {};
+  if (fstat(directory.get(), &directory_status) != 0 ||
+      directory_status.st_dev != prepared_status.st_dev ||
+      directory_status.st_ino != prepared_status.st_ino ||
+      !r0dump_IsPreparedRunDirectory(directory.get())) {
+    return r0dump_Failure("validate_reopened_run", errno == 0 ? EACCES : errno);
+  }
+
+  *out_run_fd = directory.release();
+  return r0dump_Success();
+}
+
+bool r0dump_IsSafeFileComponent(std::string_view component) {
+  if (component.empty() || component.size() > NAME_MAX || component == "." || component == "..") {
+    return false;
+  }
+  for (const char character : component) {
+    if (character == '/' || character == '\\' || character == '\0') {
+      return false;
+    }
+  }
+  return true;
+}
+
+r0dump_FileResult r0dump_OpenRunDirectoryAt(int output_parent_fd,
+                                            std::string_view run_id,
+                                            std::string_view process_pid,
+                                            int* out_run_fd) {
+  if (out_run_fd == nullptr || output_parent_fd < 0 || !r0dump_IsSafeFileComponent(run_id) ||
+      !r0dump_IsSafeFileComponent(process_pid)) {
+    return r0dump_Failure("validate_path", EINVAL);
+  }
+  *out_run_fd = -1;
+  unique_fd r0dump_directory = r0dump_OpenPrivateDirectory(output_parent_fd, "r0dump-fusion");
+  if (r0dump_directory.get() < 0) {
+    return r0dump_Failure("open_r0dump", errno);
+  }
+  unique_fd runs_directory = r0dump_OpenPrivateDirectory(r0dump_directory.get(), "runs");
+  if (runs_directory.get() < 0) {
+    return r0dump_Failure("open_runs", errno);
+  }
+  unique_fd run_directory = r0dump_OpenPrivateDirectory(runs_directory.get(), run_id);
+  if (run_directory.get() < 0) {
+    return r0dump_Failure("open_run", errno);
+  }
+  const std::string process_component(process_pid);
+  if (mkdirat(run_directory.get(), process_component.c_str(), kR0dumpDirectoryMode) != 0) {
+    return r0dump_Failure("create_process", errno);
+  }
+  unique_fd process_directory(openat(run_directory.get(),
+                                     process_component.c_str(),
+                                     O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+  if (process_directory.get() < 0) {
+    const int error = errno;
+    unlinkat(run_directory.get(), process_component.c_str(), AT_REMOVEDIR);
+    errno = error;
+    return r0dump_Failure("open_process", errno);
+  }
+  if (!r0dump_SetSharedStorageMode(process_directory.get(), kR0dumpDirectoryMode) ||
+      !r0dump_IsDirectory(process_directory.get())) {
+    return r0dump_Failure("validate_process", EACCES);
+  }
+  for (std::string_view directory_name : {"metadata", "artifacts", "records", "methods"}) {
+    unique_fd directory = r0dump_OpenPrivateDirectory(process_directory.get(), directory_name);
+    if (directory.get() < 0) {
+      return r0dump_Failure("prepare_fixed_directory", errno);
+    }
+  }
+  *out_run_fd = process_directory.release();
+  return r0dump_Success();
+}
+
+r0dump_FileResult r0dump_OpenRunDirectory(std::string_view output_parent,
+                                          std::string_view run_id,
+                                          std::string_view process_pid,
+                                          int* out_run_fd) {
+  if (out_run_fd == nullptr || output_parent.empty() ||
+      output_parent.find('\0') != std::string_view::npos) {
+    return r0dump_Failure("validate_path", EINVAL);
+  }
+  *out_run_fd = -1;
+  const std::string path(output_parent);
+  unique_fd output_directory(open(path.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC));
+  if (output_directory.get() < 0) {
+    return r0dump_Failure("open_output_parent", errno);
+  }
+  return r0dump_OpenRunDirectoryAt(output_directory.get(), run_id, process_pid, out_run_fd);
+}
+
+r0dump_FileResult r0dump_WriteAtomicFileSegments(int run_fd,
+                                                 std::string_view file_name,
+                                                 const r0dump_FileSegment* segments,
+                                                 size_t segment_count) {
+  if (run_fd < 0 || !r0dump_IsSafeFileComponent(file_name) ||
+      (segments == nullptr && segment_count != 0u) || !r0dump_IsDirectory(run_fd)) {
+    return r0dump_Failure("validate_file", EINVAL);
+  }
+  size_t total_size = 0u;
+  for (size_t index = 0u; index != segment_count; ++index) {
+    if (segments[index].data == nullptr && segments[index].size != 0u) {
+      return r0dump_Failure("validate_segment", EINVAL);
+    }
+    if (segments[index].size > std::numeric_limits<size_t>::max() - total_size) {
+      return r0dump_Failure("validate_segment", EOVERFLOW);
+    }
+    total_size += segments[index].size;
+  }
+
+  std::string temporary_name;
+  unique_fd temporary = r0dump_OpenUniqueTemporary(run_fd, &temporary_name);
+  if (temporary.get() < 0) {
+    return r0dump_Failure("open_temporary", errno);
+  }
+  const auto r0dump_remove_temporary = [&]() {
+    temporary.reset();
+    unlinkat(run_fd, temporary_name.c_str(), 0);
+  };
+
+  const r0dump_FileIo* io = g_r0dump_file_io.load(std::memory_order_acquire);
+  r0dump_FileResult write_result =
+      r0dump_WriteSegments(temporary.get(), segments, segment_count, *io);
+  if (!write_result.ok) {
+    r0dump_remove_temporary();
+    return write_result;
+  }
+  if (r0dump_FsyncRetry(temporary.get(), *io) != 0) {
+    const int error = errno;
+    r0dump_remove_temporary();
+    return r0dump_Failure("fsync_file", error);
+  }
+  const int temporary_fd = temporary.release();
+  if (close(temporary_fd) != 0) {
+    const int error = errno;
+    unlinkat(run_fd, temporary_name.c_str(), 0);
+    return r0dump_Failure("close_file", error);
+  }
+
+  const std::string canonical_name(file_name);
+  int rename_result;
+  do {
+    rename_result = io->renameat_fn(run_fd, temporary_name.c_str(), run_fd, canonical_name.c_str());
+  } while (rename_result != 0 && errno == EINTR);
+  if (rename_result != 0) {
+    const int error = errno;
+    unlinkat(run_fd, temporary_name.c_str(), 0);
+    return r0dump_Failure("rename", error);
+  }
+  if (r0dump_FsyncRetry(run_fd, *io) != 0) {
+    return r0dump_Failure("fsync_directory", errno);
+  }
+  return r0dump_Success();
+}
