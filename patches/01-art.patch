+r0dump_FileResult r0dump_WriteSessionFile(int run_fd,
+                                          const r0dump_ProcessConfig& config,
+                                          uint32_t pid,
+                                          uint32_t uid,
+                                          uint64_t start_monotonic_ns,
+                                          std::string_view build_fingerprint,
+                                          std::string_view art_apex_versions,
+                                          std::string_view manifest_status,
+                                          std::string_view bootstrap_inventory_status) {
+  const std::string json = r0dump_SerializeSession(config,
+                                                   pid,
+                                                   uid,
+                                                   start_monotonic_ns,
+                                                   build_fingerprint,
+                                                   art_apex_versions,
+                                                   manifest_status,
+                                                   bootstrap_inventory_status);
+  return r0dump_WriteAtomicFile(run_fd, "session.json", json.data(), json.size());
+}
+
+r0dump_FileResult r0dump_WriteManifestFile(int run_fd, const r0dump_ManifestSnapshot& snapshot) {
+  if (snapshot.status.empty() || snapshot.source_count > 33u ||
+      snapshot.sources.size() != snapshot.source_count ||
+      snapshot.parsed_source_count > snapshot.source_count ||
+      snapshot.rejected_source_count > snapshot.source_count ||
+      snapshot.seeds.size() > kR0dumpManifestComponentsHardLimit) {
+    return r0dump_Failure("validate_manifest", EINVAL);
+  }
+  for (size_t index = 0u; index != snapshot.sources.size(); ++index) {
+    const r0dump_ManifestSource& source = snapshot.sources[index];
+    if (source.ordinal != index || source.kind.empty() || source.status.empty()) {
+      return r0dump_Failure("validate_manifest_source", EINVAL);
+    }
+  }
+  unique_fd metadata_directory = r0dump_OpenPreparedDirectory(run_fd, "metadata");
+  if (metadata_directory.get() < 0) {
+    return r0dump_Failure("open_metadata", errno);
+  }
+  const std::string json = r0dump_SerializeManifest(snapshot);
+  return r0dump_WriteAtomicFile(
+      metadata_directory.get(), "manifest.json", json.data(), json.size());
+}
+
+r0dump_FileResult r0dump_WriteSummaryFile(int run_fd,
+                                          const r0dump_BufferSummary& buffer,
+                                          const std::array<uint64_t, kR0dumpPointCount>& point_seen,
+                                          const r0dump_WriterState& writer,
+                                          std::string_view completion_reason) {
+  if (completion_reason.empty() || writer.r0dump_IsDegraded()) {
+    return r0dump_Failure("validate_summary", EINVAL);
+  }
+  const std::string json = r0dump_SerializeSummary(buffer, point_seen, writer, completion_reason);
+  const r0dump_FileResult written =
+      r0dump_WriteAtomicFile(run_fd, "summary.json", json.data(), json.size());
+  if (!written.ok && written.operation == "fsync_directory") {
+    unlinkat(run_fd, "summary.json", 0);
+    const r0dump_FileIo* io = g_r0dump_file_io.load(std::memory_order_acquire);
+    r0dump_FsyncRetry(run_fd, *io);
+  }
+  return written;
+}
+
+r0dump_GenerationWriteResult r0dump_WriteFrozenGeneration(int run_fd,
+                                                          std::string_view run_id,
+                                                          uint32_t pid,
+                                                          const r0dump_FrozenGeneration& generation,
+                                                          r0dump_WriterState* state) {
+  const auto r0dump_degrade = [&](std::string_view operation,
+                                  int error,
+                                  size_t artifacts_written = 0u,
+                                  size_t records_written = 0u) {
+    state->degraded_ = true;
+    return r0dump_GenerationWriteResult{
+        .ok = false,
+        .degraded = true,
+        .artifacts_written = artifacts_written,
+        .records_written = records_written,
+        .error = error,
+        .operation = std::string(operation),
+    };
+  };
+  if (state == nullptr || run_fd < 0 || run_id.empty() || pid == 0u || generation.dex == nullptr ||
+      generation.code_items == nullptr || generation.records == nullptr) {
+    return state == nullptr
+               ? r0dump_GenerationWriteResult{.error = EINVAL, .operation = "validate_generation"}
+               : r0dump_degrade("validate_generation", EINVAL);
+  }
+  if (state->degraded_) {
+    return {.ok = false, .degraded = true, .error = EIO, .operation = "writer_degraded"};
+  }
+
+  std::vector<r0dump_ArtifactDescriptor> artifacts;
+  for (const auto& bucket : *generation.dex) {
+    for (const r0dump_PendingDex& pending : bucket.second) {
+      artifacts.push_back({pending.payload_id, bucket.first.capture_kind, pending.capture.get()});
+    }
+  }
+  for (const auto& bucket : *generation.code_items) {
+    for (const r0dump_PendingCodeItem& pending : bucket.second) {
+      artifacts.push_back(
+          {pending.payload_id, r0dump_CaptureKind::kCodeItem, pending.capture.get()});
+    }
+  }
+  std::sort(artifacts.begin(), artifacts.end(), [](const auto& left, const auto& right) {
+    return left.payload_id < right.payload_id;
+  });
+  for (size_t index = 0u; index < artifacts.size(); ++index) {
+    if (artifacts[index].payload_id == 0u || artifacts[index].capture == nullptr ||
+        r0dump_ArtifactExtension(artifacts[index].kind).empty() ||
+        (index != 0u && artifacts[index - 1u].payload_id == artifacts[index].payload_id)) {
+      return r0dump_degrade("validate_artifact", EINVAL);
+    }
+  }
+
+  std::vector<const r0dump_PendingRecord*> records;
+  records.reserve(generation.records->size());
+  for (const r0dump_PendingRecord& record : *generation.records) {
+    records.push_back(&record);
+  }
+  std::sort(records.begin(), records.end(), [](const auto* left, const auto* right) {
+    return left->sequence < right->sequence;
+  });
+  uint64_t previous_sequence = state->last_record_sequence_;
+  for (const r0dump_PendingRecord* record : records) {
+    if (record->sequence <= previous_sequence || !r0dump_IsDefinedPoint(record->point) ||
+        record->site.empty()) {
+      return r0dump_degrade("validate_record", EINVAL);
+    }
+    previous_sequence = record->sequence;
+  }
+
+  unique_fd artifacts_directory = r0dump_OpenPreparedDirectory(run_fd, "artifacts");
+  if (artifacts_directory.get() < 0) {
+    return r0dump_degrade("open_artifacts", errno);
+  }
+  unique_fd records_directory = r0dump_OpenPreparedDirectory(run_fd, "records");
+  if (records_directory.get() < 0) {
+    return r0dump_degrade("open_records", errno);
+  }
+  unique_fd methods_directory = r0dump_OpenPreparedDirectory(run_fd, "methods");
+  if (methods_directory.get() < 0) {
+    return r0dump_degrade("open_methods", errno);
+  }
+
+  std::vector<std::pair<uint64_t, r0dump_ArtifactReference>> references;
+  references.reserve(artifacts.size());
+  std::array<uint64_t, 5u> artifact_bytes = state->artifact_bytes_;
+  size_t artifacts_written = 0u;
+  for (const r0dump_ArtifactDescriptor& artifact : artifacts) {
+    const uint64_t artifact_id = state->next_artifact_id_;
+    const std::string file_name =
+        r0dump_NumberedName(artifact_id, r0dump_ArtifactExtension(artifact.kind));
+    if (file_name.empty()) {
+      return r0dump_degrade("allocate_artifact_name", EOVERFLOW, artifacts_written);
+    }
+    std::vector<r0dump_FileSegment> segments;
+    segments.reserve(artifact.capture->r0dump_SegmentCount());
+    for (size_t index = 0u; index < artifact.capture->r0dump_SegmentCount(); ++index) {
+      const r0dump_Segment segment = artifact.capture->r0dump_GetSegment(index);
+      segments.push_back({segment.data, segment.size});
+    }
+    const r0dump_FileResult written = r0dump_WriteAtomicFileSegments(
+        artifacts_directory.get(), file_name, segments.data(), segments.size());
+    if (!written.ok) {
+      return r0dump_degrade(written.operation, written.error, artifacts_written, 0u);
+    }
+    references.emplace_back(artifact.payload_id,
+                            r0dump_ArtifactReference{
+                                artifact_id,
+                                "artifacts/" + file_name,
+                                artifact.capture->r0dump_Hash(),
+                            });
+    const size_t kind_index = static_cast<size_t>(artifact.kind) - 1u;
+    if (kind_index >= artifact_bytes.size()) {
+      return r0dump_degrade("count_artifact", EINVAL, artifacts_written);
+    }
+    artifact_bytes[kind_index] += artifact.capture->r0dump_Size();
+    ++state->next_artifact_id_;
+    ++artifacts_written;
+  }
+
+  size_t records_written = 0u;
+  std::string methods_jsonl = state->methods_jsonl_;
+  uint64_t walk_cookie_records = state->walk_cookie_records_;
+  uint64_t walk_loaded_table_records = state->walk_loaded_table_records_;
+  uint64_t walk_manifest_records = state->walk_manifest_records_;
+  uint64_t force_attempt_records = state->force_attempt_records_;
+  uint64_t force_materialized_records = state->force_materialized_records_;
+  uint64_t force_no_dispatch_records = state->force_no_dispatch_records_;
+  for (const r0dump_PendingRecord* record : records) {
+    const r0dump_ArtifactReference* reference = nullptr;
+    if (record->payload_id != 0u) {
+      const auto found = std::lower_bound(
+          references.begin(),
+          references.end(),
+          record->payload_id,
+          [](const auto& candidate, uint64_t payload_id) { return candidate.first < payload_id; });
+      if (found == references.end() || found->first != record->payload_id) {
+        return r0dump_degrade("resolve_artifact", EINVAL, artifacts_written, records_written);
+      }
+      reference = &found->second;
+    }
+    const std::string file_name = r0dump_NumberedName(record->sequence, ".json");
+    if (file_name.empty()) {
+      return r0dump_degrade("allocate_record_name", EOVERFLOW, artifacts_written, records_written);
+    }
+    const std::string json = r0dump_SerializeRecord(*record, run_id, pid, reference);
+    const r0dump_FileResult written =
+        r0dump_WriteAtomicFile(records_directory.get(), file_name, json.data(), json.size());
+    if (!written.ok) {
+      return r0dump_degrade(written.operation, written.error, artifacts_written, records_written);
+    }
+    state->last_record_sequence_ = record->sequence;
+    r0dump_LogDurableRecord(*record, reference, run_id, pid);
+    if (record->capture_kind == r0dump_CaptureKind::kCodeItem) {
+      methods_jsonl.append(json);
+    }
+    if (record->metadata.source_kind == "cookie_class_list") {
+      ++walk_cookie_records;
+    } else if (record->metadata.source_kind == "loaded_class_table") {
+      ++walk_loaded_table_records;
+    } else if (record->metadata.source_kind == "manifest_seed") {
+      ++walk_manifest_records;
+    }
+    if (record->point == r0dump_Point::kForceInvokeNoExecute) {
+      ++force_attempt_records;
+      if (record->status != r0dump_RecordStatus::kDropped) {
+        ++force_materialized_records;
+      }
+      if (record->metadata.dispatch_status == "suppressed_before_dispatch") {
+        ++force_no_dispatch_records;
+      }
+    }
+    ++records_written;
+  }
+
+  const r0dump_FileResult methods_written = r0dump_WriteAtomicFile(
+      methods_directory.get(), "methods.jsonl", methods_jsonl.data(), methods_jsonl.size());
+  if (!methods_written.ok) {
+    return r0dump_degrade(
+        methods_written.operation, methods_written.error, artifacts_written, records_written);
+  }
+  state->last_record_sequence_ = previous_sequence;
+  state->artifact_bytes_ = artifact_bytes;
+  state->methods_jsonl_ = std::move(methods_jsonl);
+  state->walk_cookie_records_ = walk_cookie_records;
+  state->walk_loaded_table_records_ = walk_loaded_table_records;
+  state->walk_manifest_records_ = walk_manifest_records;
+  state->force_attempt_records_ = force_attempt_records;
+  state->force_materialized_records_ = force_materialized_records;
+  state->force_no_dispatch_records_ = force_no_dispatch_records;
+
+  return {
+      .ok = true,
+      .degraded = false,
+      .artifacts_written = artifacts_written,
+      .records_written = records_written,
+  };
+}
+
+r0dump_GenerationWriteResult r0dump_WriteAndReleaseFrozenGeneration(
+    int run_fd,
+    std::string_view run_id,
+    uint32_t pid,
+    const r0dump_FrozenGeneration& generation,
+    r0dump_Staging* staging,
+    r0dump_WriterState* state) {
+  r0dump_GenerationWriteResult result =
+      r0dump_WriteFrozenGeneration(run_fd, run_id, pid, generation, state);
+  if (result.ok) {
+    if (staging == nullptr || !staging->r0dump_ReleaseFrozen(generation.generation_id)) {
+      return {.ok = false, .degraded = true, .error = EINVAL, .operation = "release_generation"};
+    }
+    const std::string run_object = "run:" + std::string(run_id);
+    r0dump_Log(r0dump_LogLevel::kInfo,
+               "capture_flushed",
+               {{"status", "ok"},
+                {"site", "file.flush"},
+                {"object_kind", "run"},
+                {"object", run_object},
+                {"run_id", run_id},
+                {"pid", std::to_string(pid)}});
+    return result;
+  }
+  if (!result.ok) {
+    result.degraded = true;
+    return result;
+  }
+  return result;
+}
+
+namespace {
+
+void r0dump_MarkFlushDegradedLocked() {
+  g_r0dump_flush_degraded = true;
+  const std::string run_object =
+      g_r0dump_log_run_id.empty() ? "run:-" : "run:" + g_r0dump_log_run_id;
+  r0dump_Log(r0dump_LogLevel::kError,
+             "run_degraded",
+             {{"status", "write_failed"},
+              {"site", "file.flush"},
+              {"object_kind", "run"},
+              {"object", run_object},
+              {"run_id", g_r0dump_log_run_id},
+              {"package", g_r0dump_log_package},
+              {"process", g_r0dump_log_process}});
+}
+
+bool r0dump_ServiceFlushLocked(const r0dump_ProcessConfig& config,
+                               r0dump_Staging& staging,
+                               bool force_completion,
+                               bool try_freeze) {
+  if (g_r0dump_flush_degraded ||
+      (g_r0dump_writer_state != nullptr && g_r0dump_writer_state->r0dump_IsDegraded())) {
+    return false;
+  }
+  if (force_completion && staging.r0dump_ShouldFlush(NanoTime(), true)) {
+    g_r0dump_flush_requested.store(true, std::memory_order_release);
+  }
+  if (g_r0dump_pending_generation == nullptr &&
+      !g_r0dump_flush_requested.load(std::memory_order_acquire) &&
+      !staging.r0dump_ShouldFlush(NanoTime(), false)) {
+    return false;
+  }
+  if (g_r0dump_pending_generation == nullptr) {
+    r0dump_FreezeResult frozen = staging.r0dump_TryFreeze(try_freeze);
+    if (frozen.status != r0dump_FreezeStatus::kFrozen) {
+      return false;
+    }
+    g_r0dump_pending_generation = std::move(frozen.generation);
+  }
+  if (!r0dump_EnsureRunOpenLocked(config)) {
+    r0dump_MarkFlushDegradedLocked();
+    return false;
+  }
+  const r0dump_GenerationWriteResult result =
+      r0dump_WriteAndReleaseFrozenGeneration(g_r0dump_run_fd,
+                                             config.run_id,
+                                             static_cast<uint32_t>(getpid()),
+                                             *g_r0dump_pending_generation,
+                                             &staging,
+                                             g_r0dump_writer_state.get());
+  if (!result.ok) {
+    r0dump_MarkFlushDegradedLocked();
+    return false;
+  }
+  g_r0dump_pending_generation.reset();
+  g_r0dump_flush_requested.store(false, std::memory_order_release);
+  return staging.r0dump_ShouldFlush(NanoTime(), false);
+}
+
+}  // namespace
+
+void r0dump_InitializeFlushRun(const r0dump_ProcessConfig& config, uint64_t start_monotonic_ns) {
+  std::lock_guard<std::mutex> flush_lock(g_r0dump_flush_lock);
+  g_r0dump_log_run_id = config.run_id;
+  g_r0dump_log_package = config.target_package;
+  g_r0dump_log_process = config.process_name;
+  if (g_r0dump_start_monotonic_ns == 0u) {
+    g_r0dump_start_monotonic_ns = start_monotonic_ns;
+  }
+  if (g_r0dump_manifest_status.empty()) {
+    g_r0dump_manifest_status = config.manifest_enabled ? "pending" : "disabled";
+  }
+}
+
+bool r0dump_RequestFlush(r0dump_Staging& staging, bool force_completion) {
+  if (!staging.r0dump_ShouldFlush(NanoTime(), force_completion)) {
+    return false;
+  }
+  g_r0dump_flush_requested.store(true, std::memory_order_release);
+  return true;
+}
+
+bool r0dump_ServiceFlush(const r0dump_ProcessConfig& config,
+                         r0dump_Staging& staging,
+                         bool force_completion,
+                         bool try_lock) {
+  std::unique_lock<std::mutex> flush_lock(g_r0dump_flush_lock, std::defer_lock);
+  if (try_lock) {
+    if (!flush_lock.try_lock()) {
+      return false;
+    }
+  } else {
+    flush_lock.lock();
+  }
+
+  return r0dump_ServiceFlushLocked(config, staging, force_completion, try_lock);
+}
+
+bool r0dump_IsFlushDegraded() {
+  std::lock_guard<std::mutex> flush_lock(g_r0dump_flush_lock);
+  return g_r0dump_flush_degraded;
+}
+
+bool r0dump_PublishManifestSnapshot(const r0dump_ProcessConfig& config,
+                                    const r0dump_ManifestSnapshot& snapshot) {
+  std::lock_guard<std::mutex> flush_lock(g_r0dump_flush_lock);
+  if (!config.manifest_enabled || g_r0dump_flush_degraded || !r0dump_EnsureRunOpenLocked(config)) {
+    return false;
+  }
+  const r0dump_FileResult written = r0dump_WriteManifestFile(g_r0dump_run_fd, snapshot);
+  if (!written.ok) {
+    r0dump_MarkFlushDegradedLocked();
+    return false;
+  }
+  g_r0dump_manifest_status = snapshot.status;
+  if (!r0dump_RefreshSessionLocked(config)) {
+    r0dump_MarkFlushDegradedLocked();
+    return false;
+  }
+  return true;
+}
+
+void r0dump_CompleteBootstrapInventory(const r0dump_ProcessConfig& config, bool completed) {
+  std::lock_guard<std::mutex> flush_lock(g_r0dump_flush_lock);
+  if (g_r0dump_flush_degraded) {
+    return;
+  }
+  g_r0dump_bootstrap_inventory_status = completed ? "complete" : "failed";
+  if (!r0dump_EnsureRunOpenLocked(config) || !r0dump_RefreshSessionLocked(config)) {
+    r0dump_MarkFlushDegradedLocked();
+  }
+}
+
+void r0dump_FinalizeFlushRun(const r0dump_ProcessConfig& config,
+                             r0dump_Staging& staging,
+                             const std::array<uint64_t, kR0dumpPointCount>& point_seen,
+                             bool try_lock) {
+  std::unique_lock<std::mutex> flush_lock(g_r0dump_flush_lock, std::defer_lock);
+  if (try_lock) {
+    if (!flush_lock.try_lock()) {
+      return;
+    }
+  } else {
+    flush_lock.lock();
+  }
+  for (size_t attempt = 0u; attempt != kR0dumpMaxFrozenGenerationsHardLimit + 2u; ++attempt) {
+    if (g_r0dump_pending_generation == nullptr && !staging.r0dump_ShouldFlush(NanoTime(), true)) {
+      break;
+    }
+    r0dump_ServiceFlushLocked(
+        config, staging, /* force_completion= */ true, /* try_freeze= */ true);
+  }
+  const bool incomplete = g_r0dump_flush_degraded || g_r0dump_pending_generation != nullptr ||
+                          staging.r0dump_ShouldFlush(NanoTime(), true) ||
+                          g_r0dump_bootstrap_inventory_status == "pending" ||
+                          (config.manifest_enabled && g_r0dump_manifest_status == "pending");
+  r0dump_BufferSummary buffer_summary;
+  const bool summary_available =
+      !incomplete && staging.r0dump_GetSummary(&buffer_summary, try_lock);
+  if (!incomplete && !summary_available) {
+    r0dump_MarkFlushDegradedLocked();
+  } else if (summary_available && r0dump_EnsureRunOpenLocked(config)) {
+    unique_fd methods_directory = r0dump_OpenPreparedDirectory(g_r0dump_run_fd, "methods");
+    const r0dump_FileResult methods_written =
+        methods_directory.get() < 0
+            ? r0dump_Failure("open_methods", errno)
+            : r0dump_WriteAtomicFile(methods_directory.get(),
+                                     "methods.jsonl",
+                                     g_r0dump_writer_state->r0dump_MethodsJsonl().data(),
+                                     g_r0dump_writer_state->r0dump_MethodsJsonl().size());
+    const bool session_written = methods_written.ok && r0dump_RefreshSessionLocked(config);
+    const r0dump_FileResult summary_written = session_written
+                                                  ? r0dump_WriteSummaryFile(g_r0dump_run_fd,
+                                                                            buffer_summary,
+                                                                            point_seen,
+                                                                            *g_r0dump_writer_state,
+                                                                            "runtime_teardown")
+                                                  : r0dump_Failure("finalize_prerequisite", EIO);
+    if (!methods_written.ok || !session_written || !summary_written.ok) {
+      r0dump_MarkFlushDegradedLocked();
+    } else {
+      const std::string run_object = "run:" + config.run_id;
+      r0dump_Log(r0dump_LogLevel::kInfo,
+                 "run_completed",
+                 {{"status", "ok"},
+                  {"site", "runtime.teardown"},
+                  {"object_kind", "run"},
+                  {"object", run_object},
+                  {"run_id", config.run_id},
+                  {"package", config.target_package},
+                  {"process", config.process_name},
+                  {"pid", std::to_string(getpid())}});
+    }
+  }
+  if (g_r0dump_run_fd >= 0) {
+    close(g_r0dump_run_fd);
+    g_r0dump_run_fd = -1;
+  }
+}
+
+void r0dump_SetFileIoForTesting(const r0dump_FileIo* io) {
+  g_r0dump_file_io.store(io == nullptr ? &kR0dumpDefaultFileIo : io, std::memory_order_release);
+}
