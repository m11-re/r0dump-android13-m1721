+void r0dump_LogWalkStartedOnce(const r0dump_ProcessConfig* config = nullptr) {
+  bool expected = false;
+  if (g_r0dump_walk_started_logged.compare_exchange_strong(
+          expected, true, std::memory_order_relaxed)) {
+    const std::string run_object = config == nullptr ? "-" : "run:" + std::string(config->run_id);
+    r0dump_Log(r0dump_LogLevel::kInfo,
+               "walk_started",
+               {{"status", "started"},
+                {"site", "Walk.inventory"},
+                {"object_kind", "run"},
+                {"object", run_object},
+                {"run_id", config == nullptr ? std::string_view("-") : config->run_id},
+                {"package", config == nullptr ? std::string_view("-") : config->target_package},
+                {"process", config == nullptr ? std::string_view("-") : config->process_name}});
+  }
+}
