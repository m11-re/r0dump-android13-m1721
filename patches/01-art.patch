+static void r0dump_Runtime_r0dump_CaptureRouteCookieNative(
+    JNIEnv* env, jclass, jobject cookie, jint point_id, jstring java_class_name) {
+  r0dump_JavaRoute route;
+  if (!r0dump_GetJavaRoute(point_id, &route) || !r0dump_IsCapturePointActive(route.point)) {
+    return;
+  }
+  std::string class_name;
+  if (java_class_name != nullptr) {
+    ScopedUtfChars scoped_class_name(env, java_class_name);
+    if (scoped_class_name.c_str() == nullptr) {
+      return;
+    }
+    class_name = scoped_class_name.c_str();
+  }
+  std::vector<const DexFile*> dex_files;
+  const OatFile* oat_file = nullptr;
+  if (!art::ConvertJavaArrayToDexFiles(env, cookie, dex_files, oat_file)) {
+    return;
+  }
+  const r0dump_SourceInfo source = {
+      .kind = route.source_kind,
+      .count = static_cast<uint32_t>(dex_files.size()),
