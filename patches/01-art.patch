+bool r0dump_BufferPool::r0dump_TryPrepareCodeItem(const uint8_t* data,
+                                                  size_t size,
+                                                  r0dump_PreparedCapture* prepared) {
+  if (prepared == nullptr || prepared->r0dump_IsReady() || size > max_code_item_bytes_) {
+    return false;
+  }
+  size_t chunk_count = 0u;
+  uint64_t hash = 0u;
+  if (!r0dump_TryCopyIntoChunks(state_, data, size, &prepared->chunks_, &chunk_count, &hash)) {
+    return false;
+  }
+  prepared->state_ = state_;
+  prepared->chunk_count_ = chunk_count;
+  prepared->size_ = size;
+  prepared->hash_ = hash;
+  return true;
+}
