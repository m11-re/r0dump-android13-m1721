+bool r0dump_CheckedDexRange(uint32_t offset, uint64_t size, uint32_t file_size) {
+  return offset <= file_size && size <= static_cast<uint64_t>(file_size - offset);
+}
+
+// r0dump: A13's DexFile::Header has no GetExpectedHeaderSize(); the standard dex header is a
+// fixed 0x70 bytes on every supported version, which is what A16 computes as well.
+constexpr uint32_t kR0dumpStandardHeaderSize = 0x70u;
+
+bool r0dump_ValidateStandardDexLayout(const uint8_t* begin,
+                                      const DexFile::Header& header,
+                                      size_t readable_size) {
+  if (!StandardDexFile::IsMagicValid(header.magic_) ||
+      !StandardDexFile::IsVersionValid(header.magic_) ||
+      header.header_size_ != kR0dumpStandardHeaderSize ||
+      header.header_size_ < sizeof(DexFile::Header) || header.file_size_ < header.header_size_ ||
+      header.file_size_ > readable_size || header.endian_tag_ != DexFile::kDexEndianConstant ||
+      !r0dump_CheckedDexRange(header.data_off_, header.data_size_, header.file_size_)) {
+    return false;
+  }
+  const auto table = [&](uint32_t offset, uint32_t count, size_t item_size) {
+    return r0dump_CheckedDexRange(
+        offset, static_cast<uint64_t>(count) * item_size, header.file_size_);
+  };
+  if (!table(header.string_ids_off_, header.string_ids_size_, 4u) ||
+      !table(header.type_ids_off_, header.type_ids_size_, 4u) ||
+      !table(header.proto_ids_off_, header.proto_ids_size_, 12u) ||
+      !table(header.field_ids_off_, header.field_ids_size_, 8u) ||
+      !table(header.method_ids_off_, header.method_ids_size_, 8u) ||
+      !table(header.class_defs_off_, header.class_defs_size_, 32u) ||
+      header.map_off_ < header.data_off_ ||
+      !r0dump_CheckedDexRange(header.map_off_, sizeof(uint32_t), header.file_size_)) {
+    return false;
+  }
+  if (header.map_off_ > header.file_size_ - sizeof(uint32_t) ||
+      !r0dump_IsReadableSpan(begin + header.map_off_, sizeof(uint32_t))) {
+    return false;
+  }
+  uint32_t map_count = 0u;
+  std::memcpy(&map_count, begin + header.map_off_, sizeof(map_count));
+  constexpr size_t kMapItemBytes = 12u;
+  if (map_count > (header.file_size_ - header.map_off_ - sizeof(uint32_t)) / kMapItemBytes ||
+      !r0dump_CheckedDexRange(
+          header.map_off_, sizeof(uint32_t) + static_cast<uint64_t>(map_count) * kMapItemBytes,
+          header.file_size_) ||
+      !r0dump_IsReadableSpan(begin + header.map_off_,
+                             sizeof(uint32_t) + static_cast<size_t>(map_count) * kMapItemBytes)) {
+    return false;
+  }
+  for (uint32_t index = 0u; index != map_count; ++index) {
+    uint32_t item_offset = 0u;
+    std::memcpy(&item_offset,
+                begin + header.map_off_ + sizeof(uint32_t) + index * kMapItemBytes + 8u,
+                sizeof(item_offset));
+    if (item_offset >= header.file_size_) {
+      return false;
+    }
+  }
+  return true;
+}
+
+NO_INLINE std::optional<r0dump_DexFormat> r0dump_ValidateDexImage(const uint8_t* begin, size_t size) {
+  if (begin == nullptr || size < sizeof(DexFile::Header) ||
+      !r0dump_IsReadableSpan(begin, sizeof(DexFile::Header))) {
+    return std::nullopt;
+  }
+  DexFile::Header header;
+  std::memcpy(&header, begin, sizeof(header));
+  if (r0dump_ValidateStandardDexLayout(begin, header, size)) {
+    return r0dump_DexFormat::kStandard;
+  }
+  const bool common_valid = header.endian_tag_ == DexFile::kDexEndianConstant &&
+                            header.file_size_ >= header.header_size_ && header.file_size_ <= size;
+  // Test and legacy in-memory loaders may expose a minimal standard header
+  // without a map_list.  Keep the historical capture contract for that input;
+  // host repair still requires the complete canonical map before accepting a
+  // DEX for JADX.
+  if (common_valid && StandardDexFile::IsMagicValid(header.magic_) &&
+      StandardDexFile::IsVersionValid(header.magic_) &&
+      header.header_size_ == kR0dumpStandardHeaderSize && header.map_off_ == 0u) {
+    return r0dump_DexFormat::kStandard;
+  }
+  constexpr uint8_t kR0dumpCompactDexMagic[] = {'c', 'd', 'e', 'x', '0', '0', '1', '\0'};
+  if (common_valid && header.header_size_ >= sizeof(DexFile::Header) &&
+      std::memcmp(header.magic_, kR0dumpCompactDexMagic, sizeof(kR0dumpCompactDexMagic)) ==
+          0) {
+    return r0dump_DexFormat::kCompact;
+  }
+  return std::nullopt;
+}
