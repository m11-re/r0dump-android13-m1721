+// r0dump: instrumentation is invoked from generated entrypoints, where the callee may not use a
+// frame larger than ART_FRAME_SIZE_LIMIT; this hook's metadata assembly legitimately exceeds it,
+// so the suppression stays local to this function.
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wframe-larger-than="
+void r0dump_ObserveInstrumentationMethodEvent(r0dump_Point point,
+                                              std::string_view site,
+                                              ArtMethod* method,
+                                              std::string_view dispatch_status) {
+  r0dump_RecordMetadata metadata;
+  metadata.source_kind = "instrumentation";
+  metadata.dispatch_status = dispatch_status;
+  r0dump_TryObserveMethodMetadata(point, site, method, std::move(metadata));
+}
+#pragma GCC diagnostic pop
+
+// r0dump: the attempt object snapshots method metadata (names, descriptors, signatures) up front,
+// which needs more frame than ART_FRAME_SIZE_LIMIT allows.  Scope the suppression to this
+// constructor.
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wframe-larger-than="
+r0dump_JitCompileAttempt::r0dump_JitCompileAttempt(ArtMethod* method) : method_(method) {
+  const bool observe_begin = r0dump_IsCapturePointActiveFast(r0dump_Point::kJitCompileBegin);
+  const bool observe_end = r0dump_IsCapturePointActiveFast(r0dump_Point::kJitCompileEnd);
+  if (!observe_begin && !observe_end) {
+    return;
+  }
+  attempt_id_ = g_r0dump_jit_compile_attempt_id.fetch_add(1u, std::memory_order_relaxed) + 1u;
+  if (observe_begin) {
+    r0dump_RecordMetadata metadata;
+    metadata.source_kind = "jit_compile";
+    metadata.active_attempt_id = attempt_id_;
+    metadata.materialize_status = "attempt_started";
+    r0dump_ObserveMethodCodeItemOrMetadata(r0dump_Point::kJitCompileBegin,
+                                           "Jit.compile.begin",
+                                           method_,
+                                           r0dump_CodeItemRole::kJitCompile,
+                                           attempt_id_,
+                                           "jit_compile",
+                                           std::move(metadata));
+  }
+}
+#pragma GCC diagnostic pop
+
+bool r0dump_JitCompileAttempt::r0dump_Return(bool result) {
+  if (r0dump_IsCapturePointActiveFast(r0dump_Point::kJitCompileEnd)) {
+    r0dump_RecordMetadata metadata;
+    metadata.source_kind = "jit_compile";
+    metadata.active_attempt_id = attempt_id_;
+    metadata.materialize_status = result ? "compiled" : "not_compiled";
+    r0dump_ObserveMethodMetadata(
+        r0dump_Point::kJitCompileEnd, "Jit.compile.end", method_, std::move(metadata));
+  }
+  return result;
+}
