+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include "r0dump/r0dump_log.h"
+
+#include <android-base/logging.h>
+
+#include <chrono>
+#include <map>
+#include <mutex>
+#include <string>
+#include <tuple>
+
+namespace art HIDDEN {
+namespace {
+
+constexpr char kR0dumpLogTag[] = "R0dumpFusion";
+constexpr uint64_t kRateWindowNs = UINT64_C(1000000000);
+constexpr size_t kRecordsPerWindow = 10;
+
+struct r0dump_RateKey {
+  std::string event;
+  std::string status;
+  std::string site;
+
+  bool operator<(const r0dump_RateKey& other) const {
+    return std::tie(event, status, site) < std::tie(other.event, other.status, other.site);
+  }
+};
+
+struct r0dump_RateState {
+  uint64_t window_start_ns = 0;
+  size_t emitted = 0;
+  size_t suppressed = 0;
+};
+
+struct r0dump_LogState {
+  std::mutex lock;
+  std::map<r0dump_RateKey, r0dump_RateState> rates;
+  r0dump_LogSink sink = nullptr;
+  r0dump_LogClock clock = nullptr;
+};
+
+r0dump_LogState& r0dump_GetLogState() {
+  static r0dump_LogState* state = new r0dump_LogState;
+  return *state;
+}
+
+uint64_t r0dump_DefaultClock() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+
+android::base::LogSeverity r0dump_ToAndroidLogSeverity(r0dump_LogLevel level) {
+  switch (level) {
+    case r0dump_LogLevel::kDebug:
+      return android::base::DEBUG;
+    case r0dump_LogLevel::kInfo:
+      return android::base::INFO;
+    case r0dump_LogLevel::kWarn:
+      return android::base::WARNING;
+    case r0dump_LogLevel::kError:
+      return android::base::ERROR;
+  }
+}
+
+void r0dump_DefaultSink(r0dump_LogLevel level, std::string_view line) {
+  std::string message(line);
+  android::base::LogMessage::LogLine(
+      __FILE__, __LINE__, r0dump_ToAndroidLogSeverity(level), kR0dumpLogTag, message.c_str());
+}
+
+std::string r0dump_Escape(std::string_view value) {
+  static constexpr char kHex[] = "0123456789ABCDEF";
+  std::string escaped;
+  escaped.reserve(value.size());
+  for (unsigned char c : value) {
+    switch (c) {
+      case '\\':
+        escaped += "\\\\";
+        break;
+      case ' ':
+        escaped += "\\s";
+        break;
+      case '\n':
+        escaped += "\\n";
+        break;
+      case '\r':
+        escaped += "\\r";
+        break;
+      case '\t':
+        escaped += "\\t";
+        break;
+      case '=':
+        escaped += "\\=";
+        break;
+      default:
+        if (c < 0x20 || c == 0x7f) {
+          escaped += "\\x";
+          escaped += kHex[c >> 4];
+          escaped += kHex[c & 0x0f];
+        } else {
+          escaped += static_cast<char>(c);
+        }
+        break;
+    }
+  }
+  return escaped;
+}
+
+std::string r0dump_FindField(std::initializer_list<r0dump_LogField> fields, std::string_view key) {
+  for (const r0dump_LogField& field : fields) {
+    if (field.key == key) {
+      return std::string(field.value);
+    }
+  }
+  return "-";
+}
+
+std::string r0dump_Format(std::string_view event, std::initializer_list<r0dump_LogField> fields) {
+  std::string line = "event=" + r0dump_Escape(event);
+  for (const r0dump_LogField& field : fields) {
+    line += ' ';
+    line += r0dump_Escape(field.key);
+    line += '=';
+    line += r0dump_Escape(field.value);
+  }
+  return line;
+}
+
+std::string r0dump_FormatSuppressed(const r0dump_RateKey& key, size_t suppressed) {
+  return "event=" + r0dump_Escape(key.event) + " status=" + r0dump_Escape(key.status) +
+         " site=" + r0dump_Escape(key.site) + " suppressed=" + std::to_string(suppressed);
+}
+
+}  // namespace
+
+void r0dump_Log(r0dump_LogLevel level,
+                std::string_view event,
+                std::initializer_list<r0dump_LogField> fields) {
+  r0dump_LogState& state = r0dump_GetLogState();
+  r0dump_LogSink sink;
+  std::string summary;
+  std::string line;
+  {
+    std::lock_guard<std::mutex> lock(state.lock);
+    const uint64_t now_ns = (state.clock == nullptr) ? r0dump_DefaultClock() : state.clock();
+    r0dump_RateKey key{
+        std::string(event), r0dump_FindField(fields, "status"), r0dump_FindField(fields, "site")};
+    r0dump_RateState& rate = state.rates[key];
+    if (now_ns - rate.window_start_ns >= kRateWindowNs) {
+      if (rate.suppressed != 0u) {
+        summary = r0dump_FormatSuppressed(key, rate.suppressed);
+      }
+      rate.window_start_ns = now_ns;
+      rate.emitted = 0;
+      rate.suppressed = 0;
+    }
+    if (rate.emitted == kRecordsPerWindow) {
+      ++rate.suppressed;
+    } else {
+      ++rate.emitted;
+      line = r0dump_Format(event, fields);
+    }
+    sink = (state.sink == nullptr) ? r0dump_DefaultSink : state.sink;
+  }
+  if (!summary.empty()) {
+    sink(r0dump_LogLevel::kWarn, summary);
+  }
+  if (!line.empty()) {
+    sink(level, line);
+  }
+}
+
+void r0dump_SetLogSinkForTesting(r0dump_LogSink sink) {
+  r0dump_LogState& state = r0dump_GetLogState();
+  std::lock_guard<std::mutex> lock(state.lock);
+  state.sink = sink;
+}
+
+void r0dump_SetLogClockForTesting(r0dump_LogClock clock) {
+  r0dump_LogState& state = r0dump_GetLogState();
+  std::lock_guard<std::mutex> lock(state.lock);
+  state.clock = clock;
+}
+
+void r0dump_ResetLogStateForTesting() {
+  r0dump_LogState& state = r0dump_GetLogState();
+  std::lock_guard<std::mutex> lock(state.lock);
+  state.rates.clear();
+}
+
+}  // namespace art HIDDEN
