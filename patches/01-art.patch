+static void r0dump_Runtime_r0dump_CaptureExecutable(JNIEnv* env,
+                                                    jclass,
+                                                    jobject java_executable,
+                                                    jobject,
+                                                    jstring java_class_name,
+                                                    jint source_id) {
+  if (!r0dump_IsCapturePointActive(r0dump_Point::kWalkExecutableMethod) ||
+      java_executable == nullptr || java_class_name == nullptr) {
+    return;
+  }
+  ScopedObjectAccess soa(env);
+  ArtMethod* method = ArtMethod::FromReflectedMethod(soa, java_executable);
+  if (method == nullptr || method->IsRuntimeMethod() || method->IsAbstract() ||
+      method->IsNative() || !method->HasCodeItem()) {
+    return;
+  }
+  const DexFile* dex_file = method->GetDexFile();
+  const dex::CodeItem* code_item = method->GetCodeItem();
+  if (dex_file == nullptr || code_item == nullptr) {
+    return;
+  }
+  const std::optional<uint32_t> class_def_index =
+      method->IsProxyMethod() ? std::nullopt : std::optional<uint32_t>(method->GetClassDefIndex());
+  g_r0dump_walk_method_candidates.fetch_add(1u, std::memory_order_relaxed);
+  r0dump_PreparedCodeItem prepared;
+  if (r0dump_TryPrepareCodeItem(r0dump_Point::kWalkExecutableMethod,
+                                "Walk.executable.method",
+                                *dex_file,
+                                code_item,
+                                method->GetDexMethodIndex(),
+                                class_def_index,
+                                r0dump_CodeItemRole::kWalkExecutable,
+                                method->GetDeclaringClass()->IsInitialized(),
+                                false,
+                                &prepared) != r0dump_CaptureStatus::kSubmitted) {
+    g_r0dump_walk_code_items_rejected.fetch_add(1u, std::memory_order_relaxed);
+    return;
+  }
+  ScopedUtfChars class_name(env, java_class_name);
+  if (class_name.c_str() == nullptr) {
+    return;
+  }
+  prepared.class_name = class_name.c_str();
+  prepared.method_name = method->GetNameView();
+  prepared.method_descriptor = method->GetSignature().ToString();
+  prepared.source_kind = r0dump_SourceKind(source_id);
+  r0dump_SetPreparedMethodState(method, "walk_inventory", &prepared);
+  r0dump_SubmitPreparedCodeItem(std::move(prepared));
+  g_r0dump_walk_code_items_captured.fetch_add(1u, std::memory_order_relaxed);
+}
