+// r0dump: A13 equivalent of the upstream GetClassLoaders() helper.  Takes the
+// class linker classes lock like VisitClassLoaders() does and materialises each
+// live loader into the caller-provided handle scope.
+void ClassLinker::r0dumpVisitDexCaches(std::function<void(ObjPtr<mirror::DexCache>)> visitor) {
+  // Requires the dex lock to be held by the caller (see the header contract): the table is
+  // guarded by Locks::dex_lock_ and the weak roots must not be decoded without it.
+  Thread* self = Thread::Current();
+  for (const auto& entry : dex_caches_) {
+    ObjPtr<mirror::DexCache> dex_cache = DecodeDexCacheLocked(self, &entry.second);
+    if (dex_cache != nullptr) {
+      visitor(dex_cache);
+    }
+  }
+}
