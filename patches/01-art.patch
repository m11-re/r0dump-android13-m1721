+def r0dump_golden_dex(signature=b"bad-signature-placeholder"):
+    data = bytearray(0xA0)
+    data[0:8] = b"dex\n035\0"
+    data[32:36] = (0xA0).to_bytes(4, "little")
+    data[36:40] = DEX_HEADER_SIZE.to_bytes(4, "little")
+    data[40:44] = (0x12345678).to_bytes(4, "little")
+    data[52:56] = (0x70).to_bytes(4, "little")
+    data[104:108] = (0x30).to_bytes(4, "little")
+    data[108:112] = (0x70).to_bytes(4, "little")
+    data[0x70:0x74] = (2).to_bytes(4, "little")
+    data[0x74:0x76] = (0x0000).to_bytes(2, "little")
+    data[0x78:0x7C] = (1).to_bytes(4, "little")
+    data[0x7C:0x80] = (0).to_bytes(4, "little")
+    data[0x80:0x82] = (0x1000).to_bytes(2, "little")
+    data[0x84:0x88] = (1).to_bytes(4, "little")
+    data[0x88:0x8C] = (0x70).to_bytes(4, "little")
+    data[12:32] = signature[:20].ljust(20, b"!")
+    return bytes(data)
+
+
+def r0dump_uleb128(value):
+    encoded = []
+    while True:
+        byte = value & 0x7F
+        value >>= 7
+        encoded.append(byte | (0x80 if value else 0))
+        if not value:
+            return bytes(encoded)
+
+
+def r0dump_backfill_dex(instruction=0x000E, padding=0):
+    file_size = 0x180
+    data = bytearray(file_size)
+    data[0:8] = b"dex\n035\0"
+    struct.pack_into("<III", data, 32, file_size, DEX_HEADER_SIZE, 0x12345678)
+    string_ids_off = 0x70
+    type_ids_off = 0x7C
+    proto_ids_off = 0x84
+    method_ids_off = 0x90
+    class_defs_off = 0x98
+    data_off = 0xB8
+    map_off = 0xF4
+    strings = [b"LExample;\0", b"target\0", b"V\0"]
+    cursor = data_off
+    for index, value in enumerate(strings):
+        struct.pack_into("<I", data, string_ids_off + index * 4, cursor)
+        encoded = r0dump_uleb128(len(value) - 1) + value
+        data[cursor:cursor + len(encoded)] = encoded
+        cursor += len(encoded)
+    class_data_off = (cursor + 3) & ~3
+    code_off = (class_data_off + 11) & ~3
+    class_data = (
+        b"\0\0\1\0" + r0dump_uleb128(0) + r0dump_uleb128(1) + r0dump_uleb128(code_off)
+    )
+    data[class_data_off:class_data_off + len(class_data)] = class_data
+    struct.pack_into("<II", data, 56, 3, string_ids_off)
+    struct.pack_into("<II", data, 64, 2, type_ids_off)
+    struct.pack_into("<II", data, 72, 1, proto_ids_off)
+    struct.pack_into("<II", data, 88, 1, method_ids_off)
+    struct.pack_into("<II", data, 96, 1, class_defs_off)
+    struct.pack_into("<II", data, type_ids_off, 0, 2)
+    struct.pack_into("<III", data, proto_ids_off, 2, 1, 0)
+    struct.pack_into("<HHI", data, method_ids_off, 0, 0, 1)
+    struct.pack_into(
+        "<IIIIIIII", data, class_defs_off, 0, 1, 0xFFFFFFFF, 0,
+        0xFFFFFFFF, 0, class_data_off, 0,
+    )
+    struct.pack_into("<HHHHIIH", data, code_off, 1, 0, 0, 0, 0, 1, instruction)
+    entries = [
+        (0x0000, 1, 0),
+        (0x0001, 3, string_ids_off),
+        (0x0002, 2, type_ids_off),
+        (0x0003, 1, proto_ids_off),
+        (0x0005, 1, method_ids_off),
+        (0x0006, 1, class_defs_off),
+        (0x2002, 3, data_off),
+        (0x2000, 1, class_data_off),
+        (0x2001, 1, code_off),
+        (0x1000, 1, map_off),
+    ]
+    struct.pack_into("<I", data, map_off, len(entries))
+    cursor = map_off + 4
+    for item_type, count, offset in entries:
+        struct.pack_into("<HHII", data, cursor, item_type, 0, count, offset)
+        cursor += 12
+    struct.pack_into("<I", data, 52, map_off)
+    struct.pack_into("<II", data, 104, file_size - data_off, data_off)
+    data[-1] = padding
+    return bytes(data), code_off
+
