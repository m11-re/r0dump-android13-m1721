+void r0dump_ResetWalkCounters() {
+  g_r0dump_walk_dex_count.store(0u, std::memory_order_relaxed);
+  g_r0dump_walk_dex_cache_count.store(0u, std::memory_order_relaxed);
+  g_r0dump_walk_class_candidates.store(0u, std::memory_order_relaxed);
+  g_r0dump_walk_classes_loaded.store(0u, std::memory_order_relaxed);
+  g_r0dump_walk_class_resolve_failed.store(0u, std::memory_order_relaxed);
+  g_r0dump_walk_method_candidates.store(0u, std::memory_order_relaxed);
+  g_r0dump_walk_code_items_captured.store(0u, std::memory_order_relaxed);
+  g_r0dump_walk_code_items_rejected.store(0u, std::memory_order_relaxed);
+  g_r0dump_walk_started_logged.store(false, std::memory_order_relaxed);
