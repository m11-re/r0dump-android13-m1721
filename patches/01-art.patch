+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#include "r0dump/r0dump_nearby_snapshot.h"
+
+#include <algorithm>
+#include <cinttypes>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <utility>
+#include <vector>
+
+namespace art HIDDEN {
+namespace {
+
+constexpr size_t kDexHeaderSize = 0x70u;
+constexpr size_t kDexMagicSize = 8u;
+constexpr size_t kScanAlignment = 4u;
+
+struct r0dump_ReadableRange final {
+  uintptr_t begin = 0u;
+  uintptr_t end = 0u;
+};
+
+bool r0dump_ParseMaps(std::vector<r0dump_ReadableRange>* ranges) {
+  FILE* maps = fopen("/proc/self/maps", "re");
+  if (maps == nullptr) {
+    return false;
+  }
+  char line[512];
+  while (fgets(line, sizeof(line), maps) != nullptr) {
+    unsigned long long begin = 0u;
+    unsigned long long end = 0u;
+    char permissions[5] = {};
+    if (std::sscanf(line, "%llx-%llx %4s", &begin, &end, permissions) != 3 ||
+        permissions[0] != 'r' || begin >= end) {
+      continue;
+    }
+    ranges->push_back({static_cast<uintptr_t>(begin), static_cast<uintptr_t>(end)});
+  }
+  fclose(maps);
+  std::sort(ranges->begin(), ranges->end(), [](const auto& left, const auto& right) {
+    return left.begin < right.begin;
+  });
+  return !ranges->empty();
+}
+
+bool r0dump_IsReadableRange(const std::vector<r0dump_ReadableRange>& ranges,
+                            uintptr_t begin,
+                            size_t size) {
+  if (size == 0u || size > UINTPTR_MAX - begin) {
+    return false;
+  }
+  uintptr_t cursor = begin;
+  const uintptr_t end = begin + size;
+  for (const r0dump_ReadableRange& range : ranges) {
+    if (range.end <= cursor) {
+      continue;
+    }
+    if (range.begin > cursor) {
+      return false;
+    }
+    cursor = std::max(cursor, range.end);
+    if (cursor >= end) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool r0dump_IsDexMagic(const uint8_t* bytes) {
+  return std::memcmp(bytes, "dex\n", 4u) == 0 && bytes[4] >= '0' && bytes[4] <= '9' &&
+         bytes[5] >= '0' && bytes[5] <= '9' && bytes[6] >= '0' && bytes[6] <= '9' &&
+         bytes[7] == 0;
+}
+
+uint32_t r0dump_ReadU32(const uint8_t* bytes) {
+  uint32_t value = 0u;
+  std::memcpy(&value, bytes, sizeof(value));
+  return value;
+}
+
+size_t r0dump_Distance(uintptr_t candidate, uintptr_t anchor) {
+  return candidate <= anchor ? static_cast<size_t>(anchor - candidate)
+                             : static_cast<size_t>(candidate - anchor);
+}
+
+// Strip an arm64 top-byte/MTE tag so an anchor sourced from a heap-backed DexFile (tagged) is
+// scanned in the same untagged VA space that /proc/self/maps reports.
+uintptr_t r0dump_UntagLocal(uintptr_t address) { return address & UINT64_C(0x00ffffffffffffff); }
+
+}  // namespace
+
+std::vector<r0dump_NearbyDexCandidate> r0dump_FindNearbyDexCandidates(
+    const uint8_t* anchor,
+    size_t bytes_before,
+    size_t bytes_after,
+    size_t max_dex_bytes,
+    size_t max_candidates) {
+  std::vector<r0dump_NearbyDexCandidate> candidates;
+  if (anchor == nullptr || max_dex_bytes < kDexHeaderSize || max_candidates == 0u) {
+    return candidates;
+  }
+  const uintptr_t anchor_value = r0dump_UntagLocal(reinterpret_cast<uintptr_t>(anchor));
+  if (bytes_before > anchor_value || bytes_after > UINTPTR_MAX - anchor_value) {
+    return candidates;
+  }
+  const uintptr_t scan_begin = anchor_value - bytes_before;
+  const uintptr_t scan_end = anchor_value + bytes_after;
+  std::vector<r0dump_ReadableRange> ranges;
+  if (!r0dump_ParseMaps(&ranges)) {
+    return candidates;
+  }
+
+  for (const r0dump_ReadableRange& range : ranges) {
+    const uintptr_t begin = std::max(scan_begin, range.begin);
+    const uintptr_t end = std::min(scan_end, range.end);
+    if (begin >= end || end - begin < kDexMagicSize) {
+      continue;
+    }
+    uintptr_t cursor = (begin + (kScanAlignment - 1u)) & ~(kScanAlignment - 1u);
+    while (cursor + kDexHeaderSize <= end) {
+      const uint8_t* header = reinterpret_cast<const uint8_t*>(cursor);
+      if (r0dump_IsDexMagic(header)) {
+        const uint32_t file_size = r0dump_ReadU32(header + 32u);
+        const uint32_t header_size = r0dump_ReadU32(header + 36u);
+        if (header_size == kDexHeaderSize && file_size >= kDexHeaderSize &&
+            file_size <= max_dex_bytes &&
+            static_cast<size_t>(file_size) <= UINTPTR_MAX - cursor &&
+            cursor <= anchor_value && anchor_value - cursor < file_size &&
+            r0dump_IsReadableRange(ranges, cursor, file_size)) {
+          bool duplicate = false;
+          for (const r0dump_NearbyDexCandidate& candidate : candidates) {
+            duplicate |= candidate.begin == header;
+          }
+          if (!duplicate) {
+            candidates.push_back({header, file_size, r0dump_Distance(cursor, anchor_value)});
+            if (candidates.size() == max_candidates) {
+              return candidates;
+            }
+          }
+        }
+      }
+      cursor += kScanAlignment;
+    }
+  }
+  std::sort(candidates.begin(), candidates.end(), [](const auto& left, const auto& right) {
+    return left.distance < right.distance;
+  });
+  return candidates;
+}
+
+}  // namespace art HIDDEN
