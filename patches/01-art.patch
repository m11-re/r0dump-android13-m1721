+// Search readable process mappings around an address for complete standard DEX
+// images which contain that address.  This is deliberately bounded: it is used
+// only by the class-loader walk recovery path, never by ordinary DEX parsing.
+std::vector<r0dump_NearbyDexCandidate> r0dump_FindNearbyDexCandidates(
+    const uint8_t* anchor,
+    size_t bytes_before,
+    size_t bytes_after,
+    size_t max_dex_bytes,
