+r0dump_FileResult r0dump_WriteAtomicFile(int run_fd,
+                                         std::string_view file_name,
+                                         const void* data,
+                                         size_t size) {
+  const r0dump_FileSegment segment = {
+      .data = static_cast<const uint8_t*>(data),
+      .size = size,
+  };
+  return r0dump_WriteAtomicFileSegments(run_fd, file_name, &segment, 1u);
+}
