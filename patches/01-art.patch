+void r0dump_LogRejected(std::string_view field) {
+  Runtime* runtime = Runtime::Current();
+  const std::string package = runtime == nullptr ? "-" : runtime->GetProcessPackageName();
+  r0dump_Log(r0dump_LogLevel::kWarn,
