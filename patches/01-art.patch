+// r0dump: index into the chained fixed-size scopes in insertion order.  Every slot in every fixed
+// scope holds a mirror::Object reference, so the slot address is reinterpreted as
+// StackReference<T> for the requested subclass -- the same T-derives-from-mirror::Object contract
+// that FixedSizeHandleScope::NewHandle<T>() relies on.  The iteration starts at the front of the
+// chain, which is the most recently created scope; combined with walking each scope's used
+// references in order this yields insertion order.
+template <class T>
+inline MutableHandle<T> VariableSizedHandleScope::GetHandle(size_t i) {
+  LocalScopeType* cur = current_scope_;
+  while (cur != nullptr) {
+    const uint32_t n = cur->NumberOfReferences();
+    if (i < n) {
+      return cur->GetHandle<T>(i);
+    }
+    i -= n;
+    cur = reinterpret_cast<LocalScopeType*>(cur->GetLink());
+  }
+  DCHECK(false) << "handle index out of range";
+  return MutableHandle<T>();
+}
