+r0dump_CaptureStatus r0dump_PrepareCodeItem(r0dump_BufferPool& pool,
+                                            const DexFile& dex_file,
+                                            const dex::CodeItem* code_item,
+                                            uint32_t method_index,
+                                            std::optional<uint32_t> class_def_index,
+                                            r0dump_CodeItemRole role,
+                                            bool class_initialized,
+                                            bool no_execute,
+                                            const r0dump_HookContext& context,
+                                            r0dump_PreparedCodeItem* prepared) {
+  r0dump_RecursionGuard guard;
+  if (!guard.r0dump_Entered()) {
+    return r0dump_CaptureStatus::kReentrant;
+  }
+  if (prepared == nullptr || prepared->capture.r0dump_IsReady()) {
+    return r0dump_CaptureStatus::kInvalidRange;
+  }
+  const uint8_t* begin = nullptr;
+  size_t size = 0u;
+  uint32_t code_offset = 0u;
+  if (!r0dump_GetCodeItemSpan(
+          dex_file, code_item, pool.r0dump_MaxCodeItemBytes(), &begin, &size, &code_offset)) {
+    return r0dump_CaptureStatus::kInvalidRange;
+  }
+  if (!pool.r0dump_TryPrepareCodeItem(begin, size, &prepared->capture)) {
+    return r0dump_CaptureStatus::kPoolUnavailable;
+  }
+  prepared->context = context;
+  prepared->dex_identity = r0dump_DexIdentity(dex_file);
+  prepared->dex_size = dex_file.Size();
+  prepared->method_index = method_index;
+  prepared->code_offset = code_offset;
+  prepared->class_def_index = class_def_index;
+  prepared->role = role;
+  prepared->class_initialized = class_initialized;
+  prepared->no_execute = no_execute;
+  return r0dump_CaptureStatus::kSubmitted;
+}
+
+r0dump_CaptureResult r0dump_SubmitPreparedCodeItem(r0dump_Staging& staging,
+                                                   r0dump_PreparedCodeItem&& prepared) {
+  r0dump_RecursionGuard guard;
+  if (!guard.r0dump_Entered()) {
+    return {.status = r0dump_CaptureStatus::kReentrant};
+  }
+  std::unique_ptr<r0dump_OwnedCapture> capture = prepared.capture.r0dump_Consume();
+  if (capture == nullptr) {
+    return {.status = r0dump_CaptureStatus::kPoolUnavailable};
+  }
+  r0dump_CodeItemKey key = {
+      .dex_hash = prepared.dex_identity,
+      .dex_size = prepared.dex_size,
+      .method_index = prepared.method_index,
+      .code_offset = prepared.code_offset,
+      .attempt_id = prepared.attempt_id,
+      .role = std::string(r0dump_CodeItemRoleName(prepared.role)),
+  };
+  r0dump_CodeItemMetadata metadata = {
+      .class_name = std::move(prepared.class_name),
+      .method_name = std::move(prepared.method_name),
+      .descriptor = std::move(prepared.method_descriptor),
+      .class_initialized = prepared.class_initialized,
+      .no_execute = prepared.no_execute,
+  };
+  r0dump_RecordMetadata record_metadata = {
+      .source_kind = std::move(prepared.source_kind),
+      .class_def_index = prepared.class_def_index,
+      .entry_kind = std::move(prepared.entry_kind),
+      .access_flags = prepared.access_flags,
+      .nterp_entry_fast_path = prepared.nterp_entry_fast_path,
+      .nterp_invoke_fast_path = prepared.nterp_invoke_fast_path,
+      .code_item_present = prepared.code_item_present,
+      .observation_phase = std::move(prepared.observation_phase),
+  };
+  record_metadata.dex_object_id = prepared.dex_identity;
+  record_metadata.declared_size = prepared.dex_size;
+  record_metadata.method_index = prepared.method_index;
+  record_metadata.code_item_offset = prepared.code_offset;
+  record_metadata.code_item_size = capture->r0dump_Size();
+  return {
+      .status = r0dump_CaptureStatus::kSubmitted,
+      .submit = staging.r0dump_SubmitCodeItem(std::move(key),
+                                              std::move(capture),
+                                              std::move(metadata),
+                                              prepared.context,
+                                              std::move(record_metadata)),
+  };
+}
+
+}  // namespace art HIDDEN
