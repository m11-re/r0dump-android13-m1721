+void r0dump_LogForceEvent(r0dump_LogLevel level,
+                          std::string_view event,
+                          std::string_view status,
+                          std::string_view site,
+                          const r0dump_ProcessConfig& config,
+                          std::string_view class_name,
+                          ArtMethod* method,
+                          uint64_t attempt_id,
+                          std::string_view class_init_status,
+                          std::string_view materialize_status,
+                          std::string_view selector_source) REQUIRES_SHARED(Locks::mutator_lock_) {
+  const std::string method_name = method == nullptr ? "-" : std::string(method->GetNameView());
+  const std::string descriptor = method == nullptr ? "-" : method->GetSignature().ToString();
+  const std::string object =
+      method == nullptr ? "class:" + std::string(class_name)
+                        : "method:" + std::string(class_name) + "#" + method_name + descriptor;
+  const std::string attempt = std::to_string(attempt_id);
+  r0dump_Log(level,
+             event,
+             {{"status", status},
+              {"site", site},
+              {"object_kind", method == nullptr ? "class" : "method"},
+              {"object", object},
+              {"package", config.target_package},
+              {"process", config.process_name},
+              {"run_id", config.run_id},
+              {"class", class_name},
+              {"method", method_name},
+              {"descriptor", descriptor},
+              {"attempt_id", attempt},
+              {"selector_source", selector_source},
+              {"class_init_status", class_init_status},
+              {"materialize_status", materialize_status},
+              {"dispatch_status", "suppressed_before_dispatch"},
+              {"capture_role", "force_materialize"}});
+}
