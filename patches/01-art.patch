+void r0dump_register_dalvik_system_r0dump_Runtime(JNIEnv* env) {
+  // Called from Runtime::InitNativeMethods(), next to ART's own dalvik_system registrations.
+  //
+  // Two things matter here:
+  //  * The JNI signatures in gMethods must match the Java declarations exactly.  ART validates
+  //    them in RegisterNatives and returns an error on mismatch; the stock
+  //    REGISTER_NATIVE_METHODS macro turns that into CHECK_EQ(JNI_OK, ...), which aborts the
+  //    process.  That is fatal for zygote, so the result is inspected manually instead.
+  //  * A failure must never be fatal.  If the class cannot be resolved or the methods cannot be
+  //    registered, capture is simply unavailable for that process; it must not take the process
+  //    (let alone zygote) down with it.
+  ScopedLocalRef<jclass> klass(env, env->FindClass("dalvik/system/r0dump_Runtime"));
+  if (klass.get() == nullptr) {
+    env->ExceptionClear();
+    LOG(WARNING) << "r0dump: dalvik/system/r0dump_Runtime is not resolvable; capture disabled";
+    return;
+  }
+  const jint result = env->RegisterNatives(klass.get(), gMethods, arraysize(gMethods));
+  if (result != JNI_OK) {
+    env->ExceptionClear();
+    LOG(WARNING) << "r0dump: RegisterNatives failed (result=" << result
+                 << "); native-Java signatures are out of sync, capture disabled";
+    return;
+  }
+  LOG(INFO) << "r0dump: native methods registered";
+}
