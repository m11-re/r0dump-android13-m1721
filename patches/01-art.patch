+static jboolean r0dump_Runtime_r0dump_ForceInvoke(
+    JNIEnv* env, jclass, jobject java_executable, jobject, jstring java_class_name) {
+  const r0dump_ProcessConfig* config = r0dump_GetProcessConfig();
+  if (config == nullptr || !config->force_invoke_enabled ||
+      !r0dump_IsCapturePointActive(r0dump_Point::kForceInvokeNoExecute) ||
+      java_executable == nullptr || java_class_name == nullptr) {
+    return JNI_FALSE;
+  }
+
+  ScopedUtfChars class_name(env, java_class_name);
+  if (class_name.c_str() == nullptr) {
+    return JNI_FALSE;
+  }
+  ScopedObjectAccess soa(env);
+  ArtMethod* method = ArtMethod::FromReflectedMethod(soa, java_executable);
+  if (method == nullptr || method->IsRuntimeMethod() || method->IsProxyMethod() ||
+      method->IsAbstract() || method->IsNative() || !method->HasCodeItem()) {
+    return JNI_FALSE;
+  }
+  std::string descriptor_storage;
+  if (class_name.c_str() !=
+      DescriptorToDot(method->GetDeclaringClass()->GetDescriptor(&descriptor_storage))) {
+    return JNI_FALSE;
+  }
+
+  uint32_t call_count = g_r0dump_force_invoke_calls.load(std::memory_order_relaxed);
+  while (call_count < config->force_max_calls &&
+         !g_r0dump_force_invoke_calls.compare_exchange_weak(
+             call_count, call_count + 1u, std::memory_order_relaxed)) {}
+  if (call_count >= config->force_max_calls) {
+    return JNI_FALSE;
+  }
+
+  const std::string_view selector_source =
+      config->force_class.empty() ? "manifest_namespace" : "exact";
+  const uint64_t attempt_id =
+      g_r0dump_force_invoke_attempts.fetch_add(1u, std::memory_order_relaxed) + 1u;
+
+  StackHandleScope<1> hs(soa.Self());
+  Handle<mirror::Class> declaring_class = hs.NewHandle(method->GetDeclaringClass());
+  r0dump_LogForceEvent(r0dump_LogLevel::kInfo,
+                       "class_init_started",
+                       "started",
+                       "ForceInvoke.request",
+                       *config,
+                       class_name.c_str(),
+                       method,
+                       attempt_id,
+                       "pending",
+                       "not_started",
+                       selector_source);
+  if (!Runtime::Current()->GetClassLinker()->EnsureInitialized(
+          soa.Self(), declaring_class, true, true) ||
+      !declaring_class->IsInitialized()) {
+    if (soa.Self()->IsExceptionPending()) {
+      soa.Self()->ClearException();
+    }
+    r0dump_LogForceEvent(r0dump_LogLevel::kWarn,
+                         "class_init_exception",
+                         "class_initialization_failed",
+                         "ForceInvoke.request",
+                         *config,
+                         class_name.c_str(),
+                         method,
+                         attempt_id,
+                         "failed",
+                         "not_started",
+                         selector_source);
+    return JNI_FALSE;
+  }
+  r0dump_LogForceEvent(r0dump_LogLevel::kInfo,
+                       "class_init_completed",
+                       "initialized",
+                       "ForceInvoke.request",
+                       *config,
+                       class_name.c_str(),
+                       method,
+                       attempt_id,
+                       "initialized",
+                       "not_started",
+                       selector_source);
+
+  r0dump_LogForceEvent(r0dump_LogLevel::kInfo,
+                       "materialize_started",
+                       "started",
+                       "ForceInvoke.no_execute",
+                       *config,
+                       class_name.c_str(),
+                       method,
+                       attempt_id,
+                       "initialized",
+                       "started",
+                       selector_source);
+  r0dump_ForceInvokeAttempt attempt(method, attempt_id);
+  if (!attempt.r0dump_Entered()) {
+    r0dump_LogForceEvent(r0dump_LogLevel::kWarn,
+                         "materialize_rejected",
+                         "guard_rejected",
+                         "ForceInvoke.no_execute",
+                         *config,
+                         class_name.c_str(),
+                         method,
+                         attempt_id,
+                         "initialized",
+                         "rejected",
+                         selector_source);
+    return JNI_FALSE;
+  }
+  JValue result;
+  method->Invoke(nullptr, nullptr, 0u, &result, method->GetShorty());
+  const bool captured = attempt.r0dump_WasCaptured();
+  r0dump_LogForceEvent(captured ? r0dump_LogLevel::kInfo : r0dump_LogLevel::kWarn,
+                       captured ? "materialize_captured" : "materialize_rejected",
+                       captured ? "captured" : "not_captured",
+                       "ForceInvoke.no_execute",
+                       *config,
+                       class_name.c_str(),
+                       method,
+                       attempt_id,
+                       "initialized",
+                       captured ? "captured" : "rejected",
+                       selector_source);
+  return captured ? JNI_TRUE : JNI_FALSE;
+}
