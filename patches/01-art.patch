+r0dump_CaptureResult r0dump_CopyAndSubmitDex(r0dump_BufferPool& pool,
+                                             r0dump_Staging& staging,
+                                             const uint8_t* begin,
+                                             size_t size,
+                                             r0dump_CaptureKind kind,
+                                             r0dump_DexFormat format,
+                                             const r0dump_HookContext& context,
+                                             r0dump_RecordMetadata metadata) {
+  std::unique_ptr<r0dump_OwnedCapture> capture = pool.r0dump_TryAcquire(begin, size);
+  if (capture == nullptr) {
+    return {
+        .status = r0dump_CaptureStatus::kPoolUnavailable,
+        .submit = staging.r0dump_RecordDrop(
+            context, kind, format, "pool_unavailable", std::move(metadata)),
+    };
+  }
+  return {
+      .status = r0dump_CaptureStatus::kSubmitted,
+      .submit =
+          staging.r0dump_SubmitDex(kind, format, std::move(capture), context, std::move(metadata)),
+  };
+}
