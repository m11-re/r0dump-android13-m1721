+void r0dump_ObserveDexSources(r0dump_Point point,
+                              std::string_view site,
+                              const std::vector<std::unique_ptr<const DexFile>>& dex_files,
+                              std::string_view source_kind,
+                              std::optional<bool> in_memory,
+                              std::optional<uint64_t> active_attempt_id) {
+  if (!r0dump_IsCapturePointActive(point)) {
+    return;
+  }
+  const uint32_t source_count = dchecked_integral_cast<uint32_t>(dex_files.size());
+  for (uint32_t ordinal = 0u; ordinal != source_count; ++ordinal) {
+    r0dump_ObserveDexSource(point,
+                            site,
+                            *dex_files[ordinal],
+                            {
+                                .kind = source_kind,
+                                .ordinal = ordinal,
+                                .count = source_count,
+                                .in_memory = in_memory,
+                                .active_attempt_id = active_attempt_id,
+                            });
+  }
+}
