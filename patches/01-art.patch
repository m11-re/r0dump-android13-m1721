+bool r0dump_RefreshSessionLocked(const r0dump_ProcessConfig& config) {
+  Runtime* runtime = Runtime::Current();
+  const std::string fingerprint = runtime == nullptr ? std::string() : runtime->GetFingerprint();
+  const std::string apex_versions = runtime == nullptr ? std::string() : runtime->GetApexVersions();
+  const r0dump_FileResult written = r0dump_WriteSessionFile(g_r0dump_run_fd,
+                                                            config,
+                                                            static_cast<uint32_t>(getpid()),
+                                                            static_cast<uint32_t>(geteuid()),
+                                                            g_r0dump_start_monotonic_ns,
+                                                            fingerprint,
+                                                            apex_versions,
+                                                            g_r0dump_manifest_status,
+                                                            g_r0dump_bootstrap_inventory_status);
+  return written.ok;
+}
+
+bool r0dump_EnsureRunOpenLocked(const r0dump_ProcessConfig& config) {
+  if (g_r0dump_run_fd >= 0) {
+    return true;
+  }
+  if (g_r0dump_start_monotonic_ns == 0u) {
+    g_r0dump_start_monotonic_ns = NanoTime();
+  }
+  if (g_r0dump_manifest_status.empty()) {
+    g_r0dump_manifest_status = config.manifest_enabled ? "pending" : "disabled";
+  }
+  if (config.prepared_run_fd < 0) {
+    return false;
+  }
+  int run_fd = -1;
+  if (!r0dump_OpenPreparedRunDirectory(config.prepared_run_fd, &run_fd).ok) {
+    return false;
+  }
+  g_r0dump_run_fd = run_fd;
+  if (g_r0dump_writer_state == nullptr) {
+    g_r0dump_writer_state = std::make_unique<r0dump_WriterState>();
+  }
+  if (!r0dump_RefreshSessionLocked(config)) {
+    close(g_r0dump_run_fd);
+    g_r0dump_run_fd = -1;
+    return false;
+  }
+  return true;
+}
