+std::optional<r0dump_SubmitResult> r0dump_Staging::r0dump_TryReferenceDex(
+    r0dump_CaptureKind capture_kind,
+    r0dump_DexFormat dex_format,
+    const uint8_t* data,
+    size_t size,
+    uint64_t hash,
+    const r0dump_HookContext& context,
+    const r0dump_RecordMetadata& metadata) {
+  r0dump_SubmitResult result;
+  if (data == nullptr || size == 0u || !r0dump_IsValidContext(context)) {
+    return result;
+  }
+  const r0dump_DexBlobKey key{capture_kind, dex_format, size, hash};
+  std::unique_lock<std::mutex> guard(lock_, std::try_to_lock);
+  if (!guard.owns_lock()) {
+    result.status = r0dump_SubmitStatus::kLockBusy;
+    return result;
+  }
+  return r0dump_TryReferenceDexLocked(key, data, size, context, metadata);
+}
+
+r0dump_SubmitResult r0dump_Staging::r0dump_TryReferenceDexOrMetadata(
+    r0dump_CaptureKind capture_kind,
+    r0dump_DexFormat dex_format,
+    const uint8_t* data,
+    size_t size,
+    uint64_t hash,
+    const r0dump_HookContext& context,
+    r0dump_RecordMetadata metadata) {
+  r0dump_SubmitResult result;
+  if (data == nullptr || size == 0u || !r0dump_IsValidContext(context)) {
+    return result;
+  }
+  const r0dump_DexBlobKey key{capture_kind, dex_format, size, hash};
+  std::unique_lock<std::mutex> guard(lock_, std::try_to_lock);
+  if (!guard.owns_lock()) {
+    result.status = r0dump_SubmitStatus::kLockBusy;
+    return result;
+  }
+  std::optional<r0dump_SubmitResult> referenced =
+      r0dump_TryReferenceDexLocked(key, data, size, context, metadata);
+  return referenced.has_value() ? *referenced
+                                : r0dump_SubmitMetadataLocked(context, std::move(metadata));
+}
+
+std::optional<r0dump_SubmitResult> r0dump_Staging::r0dump_TryReferenceDexLocked(
+    const r0dump_DexBlobKey& key,
+    const uint8_t* data,
+    size_t size,
+    const r0dump_HookContext& context,
+    const r0dump_RecordMetadata& metadata) {
+  r0dump_SubmitResult result;
+  const auto r0dump_finish = [&](r0dump_SubmitStatus status) {
+    result.status = status;
+    result.entry_count = active_entries_;
+    result.total_bytes = run_bytes_;
+    return std::optional<r0dump_SubmitResult>(result);
+  };
+  if (run_records_ >= max_records_) {
+    ++point_outcomes_[r0dump_PointIndex(context.point)].dropped;
+    return r0dump_finish(r0dump_SubmitStatus::kRecordLimit);
+  }
+  auto found = active_dex_->find(key);
+  if (found == active_dex_->end()) {
+    return std::nullopt;
+  }
+  for (r0dump_PendingDex& entry : found->second) {
+    if (entry.capture->r0dump_EqualsBytes(data, size, key.hash)) {
+      r0dump_RecordMetadata record_metadata = metadata;
+      result.sequence = r0dump_AppendRecordLocked(context,
+                                                  key.capture_kind,
+                                                  key.dex_format,
+                                                  r0dump_RecordStatus::kDuplicate,
+                                                  entry.payload_id,
+                                                  entry.observation.first_sequence,
+                                                  {},
+                                                  std::move(record_metadata));
+      result.payload_id = entry.payload_id;
+      entry.observation.r0dump_Merge(r0dump_PointBit(context.point), result.sequence);
+      return r0dump_finish(r0dump_SubmitStatus::kDuplicate);
+    }
+  }
+  return std::nullopt;
+}
+
+r0dump_SubmitResult r0dump_Staging::r0dump_SubmitCodeItem(
+    r0dump_CodeItemKey key,
+    std::unique_ptr<r0dump_OwnedCapture> capture,
+    r0dump_CodeItemMetadata&& metadata,
+    const r0dump_HookContext& context,
+    r0dump_RecordMetadata&& record_metadata) {
+  r0dump_SubmitResult result;
+  if (capture == nullptr || !r0dump_IsValidContext(context)) {
+    return result;
+  }
+  key.code_size = capture->r0dump_Size();
+  key.code_hash = capture->r0dump_Hash();
+  std::unique_lock<std::mutex> guard(lock_, std::try_to_lock);
+  if (!guard.owns_lock()) {
+    result.status = r0dump_SubmitStatus::kLockBusy;
+    return result;
+  }
+  const auto r0dump_finish = [&](r0dump_SubmitStatus status) {
+    result.status = status;
+    result.entry_count = active_entries_;
+    result.total_bytes = run_bytes_;
+    return result;
+  };
+  if (run_records_ >= max_records_) {
+    ++point_outcomes_[r0dump_PointIndex(context.point)].dropped;
+    return r0dump_finish(r0dump_SubmitStatus::kRecordLimit);
+  }
+  record_metadata.method_index = key.method_index;
+  record_metadata.code_item_offset = key.code_offset;
+  record_metadata.code_item_size = key.code_size;
+  record_metadata.class_name = metadata.class_name;
+  record_metadata.method_name = metadata.method_name;
+  record_metadata.method_descriptor = metadata.descriptor;
+  record_metadata.active_attempt_id = key.attempt_id;
+  record_metadata.capture_role = key.role;
+  record_metadata.class_init_status =
+      metadata.class_initialized ? "initialized" : "not_initialized";
+  record_metadata.dispatch_status =
+      metadata.no_execute ? "suppressed_before_dispatch" : std::string();
+  auto found = active_code_items_->find(key);
+  if (found != active_code_items_->end()) {
+    for (r0dump_PendingCodeItem& entry : found->second) {
+      if (entry.capture->r0dump_Equals(*capture)) {
+        result.sequence = r0dump_AppendRecordLocked(context,
+                                                    r0dump_CaptureKind::kCodeItem,
+                                                    r0dump_DexFormat::kNotApplicable,
+                                                    r0dump_RecordStatus::kDuplicate,
+                                                    entry.payload_id,
+                                                    entry.observation.first_sequence,
+                                                    {},
+                                                    std::move(record_metadata));
+        result.payload_id = entry.payload_id;
+        entry.observation.r0dump_Merge(r0dump_PointBit(context.point), result.sequence);
+        return r0dump_finish(r0dump_SubmitStatus::kDuplicate);
+      }
+    }
+  }
+  if (active_entries_ >= max_active_entries_) {
+    result.sequence = r0dump_AppendRecordLocked(context,
+                                                r0dump_CaptureKind::kCodeItem,
+                                                r0dump_DexFormat::kNotApplicable,
+                                                r0dump_RecordStatus::kDropped,
+                                                0u,
+                                                std::nullopt,
+                                                "active_entry_limit",
+                                                std::move(record_metadata));
+    return r0dump_finish(r0dump_SubmitStatus::kEntryLimit);
+  }
+  if (run_artifacts_ >= max_artifacts_) {
+    result.sequence = r0dump_AppendRecordLocked(context,
+                                                r0dump_CaptureKind::kCodeItem,
+                                                r0dump_DexFormat::kNotApplicable,
+                                                r0dump_RecordStatus::kDropped,
+                                                0u,
+                                                std::nullopt,
+                                                "artifact_limit",
+                                                std::move(record_metadata));
+    return r0dump_finish(r0dump_SubmitStatus::kArtifactLimit);
+  }
+  if (capture->r0dump_Size() > max_total_bytes_ ||
+      run_bytes_ > max_total_bytes_ - capture->r0dump_Size()) {
+    result.sequence = r0dump_AppendRecordLocked(context,
+                                                r0dump_CaptureKind::kCodeItem,
+                                                r0dump_DexFormat::kNotApplicable,
+                                                r0dump_RecordStatus::kDropped,
+                                                0u,
+                                                std::nullopt,
+                                                "total_bytes_limit",
+                                                std::move(record_metadata));
+    return r0dump_finish(r0dump_SubmitStatus::kTotalBytesLimit);
+  }
+  const size_t payload_size = capture->r0dump_Size();
+  const uint64_t payload_id = next_payload_id_++;
+  r0dump_PendingCodeItem entry{payload_id, std::move(capture), std::move(metadata), {}};
+  result.sequence = r0dump_AppendRecordLocked(context,
+                                              r0dump_CaptureKind::kCodeItem,
+                                              r0dump_DexFormat::kNotApplicable,
+                                              r0dump_RecordStatus::kAccepted,
+                                              payload_id,
+                                              std::nullopt,
+                                              {},
+                                              std::move(record_metadata));
+  result.payload_id = payload_id;
+  entry.observation.r0dump_Merge(r0dump_PointBit(context.point), result.sequence);
+  run_bytes_ += payload_size;
+  ++active_entries_;
+  ++run_artifacts_;
+  active_pending_bytes_ += payload_size;
+  pending_entries_high_water_ = std::max(pending_entries_high_water_, active_entries_);
+  pending_bytes_high_water_ = std::max(pending_bytes_high_water_, active_pending_bytes_);
+  last_activity_ns_ = context.monotonic_ns;
+  watermark_latched_ = active_pending_bytes_ >= flush_watermark_bytes_;
+  active_code_items_->try_emplace(std::move(key)).first->second.push_back(std::move(entry));
+  return r0dump_finish(r0dump_SubmitStatus::kAccepted);
+}
+
+r0dump_SubmitResult r0dump_Staging::r0dump_RecordDrop(const r0dump_HookContext& context,
+                                                      r0dump_CaptureKind capture_kind,
+                                                      r0dump_DexFormat dex_format,
+                                                      std::string_view reason,
+                                                      r0dump_RecordMetadata metadata) {
+  r0dump_SubmitResult result;
+  if (!r0dump_IsValidContext(context) || reason.empty()) {
+    return result;
+  }
+  std::unique_lock<std::mutex> guard(lock_, std::try_to_lock);
+  if (!guard.owns_lock()) {
+    result.status = r0dump_SubmitStatus::kLockBusy;
+    return result;
+  }
+  result.entry_count = active_entries_;
+  result.total_bytes = run_bytes_;
+  if (run_records_ >= max_records_) {
+    ++point_outcomes_[r0dump_PointIndex(context.point)].dropped;
+    result.status = r0dump_SubmitStatus::kRecordLimit;
+    return result;
+  }
+  result.sequence = r0dump_AppendRecordLocked(context,
+                                              capture_kind,
+                                              dex_format,
+                                              r0dump_RecordStatus::kDropped,
+                                              0u,
+                                              std::nullopt,
+                                              reason,
+                                              std::move(metadata));
+  result.status = r0dump_SubmitStatus::kAccepted;
+  return result;
+}
+
+r0dump_SubmitResult r0dump_Staging::r0dump_SubmitMetadata(const r0dump_HookContext& context,
+                                                          r0dump_RecordMetadata metadata) {
+  return r0dump_TrySubmitMetadata(context, std::move(metadata));
+}
+
+r0dump_SubmitResult r0dump_Staging::r0dump_TrySubmitMetadata(const r0dump_HookContext& context,
+                                                             r0dump_RecordMetadata metadata) {
+  r0dump_SubmitResult result;
+  if (!r0dump_IsValidContext(context)) {
+    return result;
+  }
+  std::unique_lock<std::mutex> guard(lock_, std::try_to_lock);
+  if (!guard.owns_lock()) {
+    result.status = r0dump_SubmitStatus::kLockBusy;
+    return result;
+  }
+  return r0dump_SubmitMetadataLocked(context, std::move(metadata));
+}
+
+r0dump_SubmitResult r0dump_Staging::r0dump_SubmitMetadataLocked(const r0dump_HookContext& context,
+                                                                r0dump_RecordMetadata metadata) {
+  r0dump_SubmitResult result;
+  result.entry_count = active_entries_;
+  result.total_bytes = run_bytes_;
+  if (run_records_ >= max_records_) {
+    ++point_outcomes_[r0dump_PointIndex(context.point)].dropped;
+    result.status = r0dump_SubmitStatus::kRecordLimit;
+    return result;
+  }
+  result.sequence = r0dump_AppendRecordLocked(context,
+                                              r0dump_CaptureKind::kMetadata,
+                                              r0dump_DexFormat::kNotApplicable,
+                                              r0dump_RecordStatus::kAccepted,
+                                              0u,
+                                              std::nullopt,
+                                              {},
+                                              std::move(metadata));
+  result.status = r0dump_SubmitStatus::kAccepted;
+  return result;
+}
+
+bool r0dump_Staging::r0dump_IsValidContext(const r0dump_HookContext& context) const {
+  return r0dump_IsDefinedPoint(context.point) && !context.site.empty() && context.tid != 0u &&
+         context.monotonic_ns != 0u;
+}
+
+uint64_t r0dump_Staging::r0dump_AppendRecordLocked(const r0dump_HookContext& context,
+                                                   r0dump_CaptureKind capture_kind,
+                                                   r0dump_DexFormat dex_format,
+                                                   r0dump_RecordStatus status,
+                                                   uint64_t payload_id,
+                                                   std::optional<uint64_t> duplicate_of,
+                                                   std::string_view drop_reason,
+                                                   r0dump_RecordMetadata&& metadata) {
+  active_records_->emplace_back();
+  r0dump_PendingRecord& record = active_records_->back();
+  record.sequence = next_record_sequence_++;
+  record.point = context.point;
+  record.site = context.site;
+  record.tid = context.tid;
+  record.monotonic_ns = context.monotonic_ns;
+  record.capture_kind = capture_kind;
+  record.dex_format = dex_format;
+  record.status = status;
+  record.payload_id = payload_id;
+  record.duplicate_of = duplicate_of;
+  record.drop_reason = drop_reason;
+  record.metadata = std::move(metadata);
+  ++run_records_;
+  r0dump_PointOutcomeCounters& outcome = point_outcomes_[r0dump_PointIndex(context.point)];
+  switch (status) {
+    case r0dump_RecordStatus::kAccepted:
+      ++outcome.accepted;
+      break;
+    case r0dump_RecordStatus::kDuplicate:
+      ++outcome.duplicate;
+      break;
+    case r0dump_RecordStatus::kDropped:
+      ++outcome.dropped;
+      break;
+  }
+  last_activity_ns_ = context.monotonic_ns;
+  return record.sequence;
+}
+
+r0dump_ActiveFlushState r0dump_Staging::r0dump_GetActiveFlushState() const {
+  std::lock_guard<std::mutex> guard(lock_);
+  return {active_pending_bytes_, last_activity_ns_, watermark_latched_};
+}
+
+bool r0dump_Staging::r0dump_ShouldFlush(uint64_t now_ns, bool force_completion) const {
+  std::lock_guard<std::mutex> guard(lock_);
+  if (active_entries_ == 0u && active_records_->empty()) {
+    return false;
+  }
+  return force_completion || watermark_latched_ ||
+         (last_activity_ns_ != 0u && now_ns >= last_activity_ns_ &&
+          now_ns - last_activity_ns_ >= flush_idle_ns_);
+}
+
+r0dump_FreezeResult r0dump_Staging::r0dump_TryFreeze(bool try_lock) {
+  auto replacement_dex = std::make_unique<r0dump_PendingDexMap>();
+  auto replacement_code_items = std::make_unique<r0dump_PendingCodeItemMap>();
+  auto replacement_records = std::make_unique<r0dump_PendingRecordList>();
+  replacement_dex->reserve(max_active_entries_);
+  replacement_code_items->reserve(max_active_entries_);
+  replacement_records->reserve(max_records_);
+  auto generation = std::make_unique<r0dump_FrozenGeneration>();
+  std::unique_lock<std::mutex> guard(lock_, std::defer_lock);
+  if (try_lock) {
+    if (!guard.try_lock()) {
+      return {.status = r0dump_FreezeStatus::kBackpressure};
+    }
+  } else {
+    guard.lock();
+  }
+  r0dump_FreezeResult result;
+  if (active_entries_ == 0 && active_records_->empty()) {
+    result.status = r0dump_FreezeStatus::kEmpty;
+    return result;
+  }
+  if (frozen_count_ >= max_frozen_generations_) {
+    result.status = r0dump_FreezeStatus::kBackpressure;
+    return result;
+  }
+  generation->generation_id = next_generation_id_++;
+  generation->dex = std::move(active_dex_);
+  generation->code_items = std::move(active_code_items_);
+  generation->records = std::move(active_records_);
+  active_dex_ = std::move(replacement_dex);
+  active_code_items_ = std::move(replacement_code_items);
+  active_records_ = std::move(replacement_records);
+  active_entries_ = 0;
+  active_pending_bytes_ = 0u;
+  last_activity_ns_ = 0u;
+  watermark_latched_ = false;
+  frozen_ids_[frozen_count_++] = generation->generation_id;
+  frozen_generations_high_water_ = std::max(frozen_generations_high_water_, frozen_count_);
+  result.status = r0dump_FreezeStatus::kFrozen;
+  result.generation = std::move(generation);
+  return result;
+}
+
+bool r0dump_Staging::r0dump_ReleaseFrozen(uint64_t generation_id) {
+  std::lock_guard<std::mutex> guard(lock_);
+  for (size_t index = 0; index < frozen_count_; ++index) {
+    if (frozen_ids_[index] == generation_id) {
+      frozen_ids_[index] = frozen_ids_[frozen_count_ - 1u];
+      frozen_ids_[--frozen_count_] = 0u;
+      return true;
+    }
+  }
+  return false;
+}
+
+r0dump_BufferSummary r0dump_Staging::r0dump_GetSummary() const {
+  r0dump_BufferSummary summary;
+  r0dump_GetSummary(&summary, /* try_lock= */ false);
+  return summary;
+}
+
+bool r0dump_Staging::r0dump_GetSummary(r0dump_BufferSummary* summary, bool try_lock) const {
+  if (summary == nullptr) {
+    return false;
+  }
+  const size_t pool_high_water = pool_ == nullptr ? 0u : pool_->r0dump_HighWaterBytes();
+  std::unique_lock<std::mutex> guard(lock_, std::defer_lock);
+  if (try_lock) {
+    if (!guard.try_lock()) {
+      return false;
+    }
+  } else {
+    guard.lock();
+  }
+  *summary = {
+      .pool_high_water_bytes = pool_high_water,
+      .pending_entries_high_water = pending_entries_high_water_,
+      .pending_bytes_high_water = pending_bytes_high_water_,
+      .frozen_generations_high_water = frozen_generations_high_water_,
+      .records = run_records_,
+      .artifacts = run_artifacts_,
+      .admitted_bytes = run_bytes_,
+      .point_outcomes = point_outcomes_,
+  };
+  return true;
+}
+
+size_t r0dump_Staging::r0dump_FrozenCount() const {
+  std::lock_guard<std::mutex> guard(lock_);
+  return frozen_count_;
+}
+
+size_t r0dump_Staging::r0dump_DexCount() const {
+  std::lock_guard<std::mutex> guard(lock_);
+  size_t count = 0;
+  for (const auto& bucket : *active_dex_) {
+    count += bucket.second.size();
+  }
+  return count;
+}
+
+size_t r0dump_Staging::r0dump_CodeItemCount() const {
+  std::lock_guard<std::mutex> guard(lock_);
+  size_t count = 0u;
+  for (const auto& bucket : *active_code_items_) {
+    count += bucket.second.size();
+  }
+  return count;
+}
+
+size_t r0dump_Staging::r0dump_RecordCount() const {
+  std::lock_guard<std::mutex> guard(lock_);
+  return run_records_;
+}
+
+size_t r0dump_Staging::r0dump_ArtifactCount() const {
+  std::lock_guard<std::mutex> guard(lock_);
+  return run_artifacts_;
+}
+
+size_t r0dump_Staging::r0dump_AdmittedBytes() const {
+  std::lock_guard<std::mutex> guard(lock_);
+  return run_bytes_;
+}
