+static jobjectArray r0dump_Runtime_r0dump_GetRegisteredClassLoaders(JNIEnv* env, jclass) {
+  r0dump_LogWalkStartedOnce(r0dump_GetProcessConfig());
+  ScopedObjectAccess soa(env);
+  VariableSizedHandleScope loaders(soa.Self());
+  Runtime::Current()->GetClassLinker()->r0dumpCollectClassLoaders(soa.Self(), &loaders);
+
+  ScopedLocalRef<jclass> loader_class(env, env->FindClass("java/lang/ClassLoader"));
+  if (loader_class.get() == nullptr) {
+    return nullptr;
+  }
+  jobjectArray result =
+      env->NewObjectArray(static_cast<jsize>(loaders.Size()), loader_class.get(), nullptr);
+  if (result == nullptr) {
+    return nullptr;
+  }
+  for (uint32_t i = 0; i < loaders.Size(); ++i) {
+    jobject loader =
+        soa.AddLocalReference<jobject>(loaders.GetHandle<mirror::ClassLoader>(i).Get());
+    env->SetObjectArrayElement(result, static_cast<jsize>(i), loader);
+    env->DeleteLocalRef(loader);
+    if (env->ExceptionCheck() == JNI_TRUE) {
+      return nullptr;
+    }
+  }
+  return result;
+}
