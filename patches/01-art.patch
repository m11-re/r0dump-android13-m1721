+// r0dump: reads the dex cookies out of a BaseDexClassLoader's DexPathList.
+//
+// A cookie is ART's opaque handle for one opened dex list, and it is the only handle that lets the
+// engine reach the dex images behind a loader directly.  Reading it here, inside ART, avoids going
+// through any Java helper a shell could shadow, and the field names below are the platform's
+// dalvik.system contract (BaseDexClassLoader.pathList -> DexPathList.dexElements ->
+// Element.dexFile -> DexFile.mInternalCookie).
+static jobjectArray r0dump_Runtime_r0dump_GetDexCookies(JNIEnv* env,
+                                                        jclass,
+                                                        jobject java_loader) {
+  ScopedLocalRef<jclass> element_class(env, env->FindClass("java/lang/Object"));
+  if (element_class.get() == nullptr) {
+    return nullptr;
+  }
+  const std::vector<jobject> empty;
+  if (java_loader == nullptr) {
+    return r0dump_NewObjectArray(env, element_class.get(), empty);
+  }
+  ScopedLocalRef<jclass> loader_class(env, env->GetObjectClass(java_loader));
+  if (loader_class.get() == nullptr) {
+    return nullptr;
+  }
+  const jfieldID path_list_field =
+      env->GetFieldID(loader_class.get(), "pathList", "Ldalvik/system/DexPathList;");
+  if (path_list_field == nullptr) {
+    env->ExceptionClear();
+    return r0dump_NewObjectArray(env, element_class.get(), empty);
+  }
+  ScopedLocalRef<jobject> path_list(env, env->GetObjectField(java_loader, path_list_field));
+  if (path_list.get() == nullptr) {
+    return r0dump_NewObjectArray(env, element_class.get(), empty);
+  }
+  ScopedLocalRef<jclass> path_list_class(env, env->GetObjectClass(path_list.get()));
+  if (path_list_class.get() == nullptr) {
+    return nullptr;
+  }
+  const jfieldID elements_field = env->GetFieldID(
+      path_list_class.get(), "dexElements", "[Ldalvik/system/DexPathList$Element;");
+  if (elements_field == nullptr) {
+    env->ExceptionClear();
+    return r0dump_NewObjectArray(env, element_class.get(), empty);
+  }
+  ScopedLocalRef<jobjectArray> elements(env, reinterpret_cast<jobjectArray>(
+                                                 env->GetObjectField(path_list.get(),
+                                                                     elements_field)));
+  if (elements.get() == nullptr) {
+    return r0dump_NewObjectArray(env, element_class.get(), empty);
+  }
+  ScopedLocalRef<jclass> dex_element_class(env, env->FindClass("dalvik/system/DexPathList$Element"));
+  if (dex_element_class.get() == nullptr) {
+    env->ExceptionClear();
+    return r0dump_NewObjectArray(env, element_class.get(), empty);
+  }
+  const jfieldID dex_file_field = env->GetFieldID(
+      dex_element_class.get(), "dexFile", "Ldalvik/system/DexFile;");
+  if (dex_file_field == nullptr) {
+    env->ExceptionClear();
+    return r0dump_NewObjectArray(env, element_class.get(), empty);
+  }
+  ScopedLocalRef<jclass> dex_file_class(env, env->FindClass("dalvik/system/DexFile"));
+  if (dex_file_class.get() == nullptr) {
+    env->ExceptionClear();
+    return r0dump_NewObjectArray(env, element_class.get(), empty);
+  }
+  // mInternalCookie survives close(), so it is the stable identity to hand back to the engine.
+  const jfieldID cookie_field =
+      env->GetFieldID(dex_file_class.get(), "mInternalCookie", "Ljava/lang/Object;");
+  if (cookie_field == nullptr) {
+    env->ExceptionClear();
+    return r0dump_NewObjectArray(env, element_class.get(), empty);
+  }
+
+  const jsize count = env->GetArrayLength(elements.get());
+  std::vector<jobject> cookies;
+  cookies.reserve(static_cast<size_t>(count));
+  for (jsize i = 0; i < count; ++i) {
+    ScopedLocalRef<jobject> element(env, env->GetObjectArrayElement(elements.get(), i));
+    if (element.get() == nullptr) {
+      continue;
+    }
+    ScopedLocalRef<jobject> dex_file(env, env->GetObjectField(element.get(), dex_file_field));
+    if (dex_file.get() == nullptr) {
+      continue;
+    }
+    ScopedLocalRef<jobject> cookie(env, env->GetObjectField(dex_file.get(), cookie_field));
+    if (cookie.get() != nullptr) {
+      cookies.push_back(env->NewLocalRef(cookie.get()));
+    }
+  }
+  if (env->ExceptionCheck() == JNI_TRUE) {
+    env->ExceptionClear();
+    for (jobject cookie : cookies) {
+      env->DeleteLocalRef(cookie);
+    }
+    return r0dump_NewObjectArray(env, element_class.get(), empty);
+  }
+  jobjectArray result = r0dump_NewObjectArray(env, element_class.get(), cookies);
+  for (jobject cookie : cookies) {
+    env->DeleteLocalRef(cookie);
+  }
+  return result;
+}
