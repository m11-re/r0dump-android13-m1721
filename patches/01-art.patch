+bool r0dump_DexBlobKey::operator==(const r0dump_DexBlobKey& other) const {
+  return capture_kind == other.capture_kind && dex_format == other.dex_format &&
+         size == other.size && hash == other.hash;
+}
+
+size_t r0dump_DexBlobKeyHash::operator()(const r0dump_DexBlobKey& key) const {
+  return static_cast<size_t>(key.hash) ^ (key.size << 1) ^
+         (static_cast<size_t>(key.capture_kind) << 17) ^
+         (static_cast<size_t>(key.dex_format) << 21);
+}
+
+bool r0dump_CodeItemKey::operator==(const r0dump_CodeItemKey& other) const {
+  return dex_hash == other.dex_hash && dex_size == other.dex_size &&
+         method_index == other.method_index && code_offset == other.code_offset &&
+         attempt_id == other.attempt_id && role == other.role && code_size == other.code_size &&
+         code_hash == other.code_hash;
+}
+
+size_t r0dump_CodeItemKeyHash::operator()(const r0dump_CodeItemKey& key) const {
+  size_t hash = static_cast<size_t>(key.dex_hash);
+  hash ^= key.dex_size + (hash << 6) + (hash >> 2);
+  hash ^= key.method_index + (hash << 6) + (hash >> 2);
+  hash ^= key.code_offset + (hash << 6) + (hash >> 2);
+  hash ^= key.attempt_id + (hash << 6) + (hash >> 2);
+  hash ^= key.code_size + (hash << 6) + (hash >> 2);
+  hash ^= key.code_hash + (hash << 6) + (hash >> 2);
+  return hash ^ std::hash<std::string>{}(key.role);
+}
