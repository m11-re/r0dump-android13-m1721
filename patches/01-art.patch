+bool r0dump_ConfigureCaptureProcessOnce(r0dump_ProcessConfig config, r0dump_ConfigError* error) {
+  if (!r0dump_ValidateConfig(config, error)) {
+    return false;
+  }
+
+  std::unique_ptr<r0dump_CaptureProcessState> state;
+  if (config.enabled) {
+    state = std::make_unique<r0dump_CaptureProcessState>(config);
+    if (!state->pool->r0dump_IsReady()) {
+      if (error != nullptr) {
+        error->code = r0dump_ConfigErrorCode::kInvalidBudget;
+        error->field = "capture_pool";
+      }
+      return false;
+    }
+  }
+
+  std::lock_guard<std::mutex> lock(g_r0dump_capture_configure_lock);
+  if (g_r0dump_capture_process_state.load(std::memory_order_relaxed) != nullptr ||
+      r0dump_GetProcessConfig() != nullptr) {
+    if (error != nullptr) {
+      error->code = r0dump_ConfigErrorCode::kAlreadyConfigured;
+      error->field = "config";
+    }
+    return false;
+  }
+  const r0dump_CapturePointMask active_mask = config.enabled ? config.capture_point_mask : 0u;
+  const bool install_open_common =
+      config.enabled &&
+      r0dump_IsCapturePointEnabled(config.capture_point_mask, r0dump_Point::kOpenCommonReturn);
+  if (!r0dump_ConfigureProcessOnce(std::move(config), error)) {
+    return false;
+  }
+  if (state != nullptr) {
+    g_r0dump_capture_process_state.store(state.release(), std::memory_order_release);
+  }
+  r0dump_SetActiveCapturePointMask(active_mask);
+  if (install_open_common) {
+    r0dump_SetOpenCommonObserver(r0dump_ObserveOpenCommon);
+  }
+  return true;
+}
