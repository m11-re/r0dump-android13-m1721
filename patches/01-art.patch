+void r0dump_ObserveDexFiles(r0dump_Point point,
+                            std::string_view site,
+                            const std::vector<std::unique_ptr<const DexFile>>& dex_files) {
+  if (!r0dump_IsCapturePointActive(point)) {
+    return;
+  }
+  for (const std::unique_ptr<const DexFile>& dex_file : dex_files) {
+    if (dex_file != nullptr) {
+      r0dump_ObserveDex(point, site, *dex_file);
+    }
+  }
+}
