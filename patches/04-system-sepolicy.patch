diff --git a/prebuilts/api/33.0/private/r0dump_file_helper.te b/prebuilts/api/33.0/private/r0dump_file_helper.te
new file mode 100644
index 0000000..9effaaf
--- /dev/null
+++ b/prebuilts/api/33.0/private/r0dump_file_helper.te
@@ -0,0 +1,69 @@
+type r0dump_file_helper, domain, coredomain;
+# The helper binary is a platform component, so its executable type follows the
+# same shape as the other built-in daemons (compare artd_exec).  init_daemon_domain
+# below requires the _exec type to exist by name.
+type r0dump_file_helper_exec, system_file_type, exec_type, file_type;
+init_daemon_domain(r0dump_file_helper)
+
+# The helper's init .rc declares a seqpacket socket named r0dump_file_helper; the
+# matching sock_file type is what system_server connects to.  Both ends live in
+# coredomain, so the type carries coredomain_socket like the other platform
+# daemon sockets (see dev/socket entries in file_contexts).
+type r0dump_file_helper_socket, file_type, coredomain_socket;
+
+# Captured app artifacts inherit the target app's MCS categories. The helper is
+# a platform daemon that validates and confines every request to the package
+# selected by system_server, so it must be able to cross those categories.
+typeattribute r0dump_file_helper mlstrustedsubject;
+
+get_prop(r0dump_file_helper, r0dump_fusion_prop)
+
+allow r0dump_file_helper self:capability { chown fowner fsetid setuid };
+allow r0dump_file_helper self:unix_stream_socket { accept listen read write getattr getopt setopt };
+
+# Traverse the per-user mount namespace before opening the FUSE-backed root.
+allow r0dump_file_helper mnt_user_file:dir search;
+
+# The emulated-storage FUSE daemon performs checks against the backing
+# media_rw data label while the helper walks and prepares app external files.
+allow r0dump_file_helper media_rw_data_file:dir create_dir_perms;
+allow r0dump_file_helper media_rw_data_file:file create_file_perms;
+
+# This device mounts /mnt/user/0/emulated with FUSE but keeps Android/data and Android/obb on
+# separate sdcardfs mounts (see the sdcardfs entries in /proc/mounts).  Upstream only had to cover
+# FUSE, so the rules below name sdcard_type alongside fuse -- sdcardfs is tagged sdcard_type, and
+# without it the helper is denied while walking into Android/data:
+#   avc: denied { search } for comm="r0dump_file_hel" name="data" dev="sdcardfs"
+#     scontext=u:r:r0dump_file_helper:s0 tcontext=u:object_r:sdcardfs:s0 tclass=dir
+allow r0dump_file_helper { sdcard_type fuse }:dir {
+  add_name
+  create
+  getattr
+  open
+  read
+  remove_name
+  rmdir
+  search
+  setattr
+  write
+};
+allow r0dump_file_helper { sdcard_type fuse }:file create_file_perms;
+
+# system_server opens the installed base/split APKs after validating the
+# Manager caller and passes only those read-only descriptors to the helper.
+allow r0dump_file_helper system_server:fd use;
+allow r0dump_file_helper apk_data_file:file { getattr read };
+
+allow system_server r0dump_file_helper_socket:sock_file write;
+allow system_server r0dump_file_helper:unix_stream_socket connectto;
+allow system_server r0dump_file_helper:fd use;
+# SELinux maps receipt of an O_PATH FD to the ioctl permission when no
+# FMODE_READ/FMODE_WRITE bit exists. This permits only FD receipt; the platform
+# neverallow still prevents system_server from opening, reading, or writing
+# external-storage directories.
+allow system_server { sdcard_type fuse }:dir ioctl;
+
+# The helper owns the directory file description even after system_server
+# duplicates it into a ParcelFileDescriptor. Only AMS can obtain and forward
+# this descriptor; its Binder entry validates the calling app UID/PID first.
+allow appdomain r0dump_file_helper:fd use;
diff --git a/prebuilts/api/33.0/private/r0dump_manager_app.te b/prebuilts/api/33.0/private/r0dump_manager_app.te
new file mode 100644
index 0000000..9171c21
--- /dev/null
+++ b/prebuilts/api/33.0/private/r0dump_manager_app.te
@@ -0,0 +1,22 @@
+type r0dump_manager_app, domain;
+typeattribute r0dump_manager_app coredomain;
+
+app_domain(r0dump_manager_app)
+
+# Match the service discovery surface available to platform-signed privileged
+# apps.  The dedicated domain remains isolated from writer/session services.
+allow r0dump_manager_app app_api_service:service_manager find;
+allow r0dump_manager_app system_api_service:service_manager find;
+
+# Manager is the sole writer; configured targets and system_server only read.
+set_prop(r0dump_manager_app, r0dump_fusion_prop)
+get_prop(appdomain, r0dump_fusion_prop)
+get_prop(system_server, r0dump_fusion_prop)
+
+# MCP bridge: the app hosts an abstract-namespace stream socket ("r0dump_mcp")
+# that the r0dump_mcp_bridge relay (spawned in the shell domain by adb exec-out)
+# connects to. Gate this to userdebug/eng where adb automation is expected.
+userdebug_or_eng(`
+    allow r0dump_manager_app self:unix_stream_socket { create bind listen accept read write getopt setopt shutdown };
+    allow shell r0dump_manager_app:unix_stream_socket connectto;
+')
